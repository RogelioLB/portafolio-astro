---
// proyecto/[slug].astro — Spanish case-study page for a single project.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const lang = 'es';

const fullTitle = `${project.name} — ${project.tag.es} | Rogelio López`;
const title = fullTitle.length > 60 ? `${project.name} — ${project.tag.es}` : fullTitle;
const description = project.problem.es;
---

<Layout
  lang={lang}
  path={`/proyecto/${project.slug}`}
  alternates={{ es: `/proyecto/${project.slug}`, en: `/en/project/${project.slug}` }}
  title={title}
  description={description}
>
  <Nav lang={lang} altPath={`/en/project/${project.slug}`} />
  <ProjectDetail project={project} lang={lang} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.name,
    description: project.summary.es,
    author: { '@type': 'Person', name: 'Rogelio López', url: 'https://www.rogeliolb.dev' },
    keywords: project.keywords.es.join(', '),
    url: `https://www.rogeliolb.dev/proyecto/${project.slug}`,
  })} />
</Layout>
