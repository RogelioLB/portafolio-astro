---
// AboutMe.astro — Bento tiles: profile+stats (full-row) · 4 skill tiles · education (full-row)
import { skillGroups, education } from '../data/about';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="about" id="sobre-mi">
  <div class="section-head">
    <span class="mono-label">{t('about.eyebrow')}</span>
    <h2>{t('about.title')}</h2>
  </div>

  <div class="bento">
    <!-- Profile + stats — wide tile -->
    <div class="tile profile-tile reveal">
      <p class="profile-text">{t('about.profile')}</p>
      <div class="stats-row">
        <div class="stat">
          <span class="stat-num">4+</span>
          <span class="stat-label">{t('about.stat.years')}</span>
        </div>
        <div class="stat">
          <span class="stat-num">10+</span>
          <span class="stat-label">{t('about.stat.projects')}</span>
        </div>
        <div class="stat">
          <span class="stat-num">13</span>
          <span class="stat-label">{t('about.stat.stars')}</span>
        </div>
      </div>
    </div>

    <!-- Skill tiles -->
    {skillGroups.map((group) => (
      <div class="tile skill-tile reveal">
        <div class="skill-head">
          <svg class="skill-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={group.icon} />
          </svg>
          <h3>{group.name[lang]}</h3>
        </div>
        <div class="badges">
          {group.items.map((item) => <span class="badge">{item}</span>)}
        </div>
      </div>
    ))}

    <!-- Education — wide tile -->
    <div class="tile education-tile reveal">
      <h3>{t('about.education.title')}</h3>
      <div class="edu-list">
        {education.map((edu) => (
          <div class="edu-row">
            <span class="edu-date mono-label">{edu.date}</span>
            <div class="edu-info">
              <span class="edu-title">{edu.title[lang]}</span>
              <span class="edu-school">{edu.school}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xl);
  }

  .section-head h2 {
    font-size: var(--text-2xl);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .profile-tile,
  .education-tile {
    grid-column: 1 / -1;
    padding: var(--space-xl);
  }

  .profile-text {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: 1.65;
    max-width: 62ch;
    margin-bottom: var(--space-lg);
  }

  .stats-row {
    display: flex;
    gap: var(--space-2xl);
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-lg);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .skill-tile {
    grid-column: span 2;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .skill-head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .skill-icon {
    width: 20px;
    height: 20px;
    color: var(--color-ink-muted);
    flex-shrink: 0;
  }

  .skill-tile:hover .skill-icon {
    color: var(--color-accent);
  }

  .skill-head h3 {
    font-size: var(--text-md);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  .education-tile h3 {
    font-size: var(--text-md);
    margin-bottom: var(--space-lg);
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .edu-row {
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .edu-row:first-child {
    padding-top: 0;
    border-top: none;
  }

  .edu-date {
    flex-shrink: 0;
    width: 6.5rem;
  }

  .edu-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .edu-title {
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .edu-school {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  @media (max-width: 60rem) {
    .skill-tile {
      grid-column: span 4;
    }
  }

  @media (max-width: 30rem) {
    .stats-row {
      gap: var(--space-lg);
      flex-wrap: wrap;
    }

    .edu-row {
      flex-direction: column;
      gap: var(--space-2xs);
    }

    .edu-date {
      width: auto;
    }
  }
</style>
