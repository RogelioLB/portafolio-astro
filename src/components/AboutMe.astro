---
// AboutMe.astro - Section showing Rogelio's professional profile, structured skills, and education
---

<section class="about-container" id="sobre-mi">
  <!-- Section Title -->
  <div class="section-title">
    <span class="icon-brackets">&lt;/&gt;</span>
    <h2>Información & Habilidades</h2>
  </div>

  <!-- Professional Profile Card -->
  <div class="glass-card profile-card">
    <h3>Perfil Profesional</h3>
    <p>
      Como Ingeniero de Software Full-Stack con más de 4 años de experiencia práctica, me apasiona la resolución de problemas y la creación de soluciones digitales eficientes. He diseñado e implementado arquitecturas robustas que van desde el aprovisionamiento de servidores seguros en entornos Linux Dockerizados, hasta la optimización de pasarelas de pago y la creación de interfaces de usuario altamente receptivas y dinámicas. 
    </p>
    <div class="stats-row">
      <div class="stat-item">
        <span class="stat-number">4+</span>
        <span class="stat-label">Años de Exp.</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">10+</span>
        <span class="stat-label">Proyectos Listos</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">3+</span>
        <span class="stat-label">SaaS Creados</span>
      </div>
    </div>
  </div>

  <!-- Skills Categories Grid -->
  <div class="skills-grid">
    <!-- Front-End Card -->
    <div class="glass-card skill-card">
      <div class="card-header">
        <div class="category-icon front-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h4>Front-End</h4>
      </div>
      <div class="skills-badges">
        <span class="badge">HTML5 / CSS3</span>
        <span class="badge">JavaScript (ES6+)</span>
        <span class="badge font-ts">TypeScript</span>
        <span class="badge font-react">React</span>
        <span class="badge font-next">Next.js</span>
        <span class="badge font-rn">React Native (Expo)</span>
        <span class="badge">Vue.js</span>
      </div>
    </div>

    <!-- Back-End Card -->
    <div class="glass-card skill-card">
      <div class="card-header">
        <div class="category-icon back-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
          </svg>
        </div>
        <h4>Back-End</h4>
      </div>
      <div class="skills-badges">
        <span class="badge font-node">Node.js / Express</span>
        <span class="badge font-cs">C# (.NET / ASP.NET)</span>
        <span class="badge font-py">Python</span>
        <span class="badge font-sql">SQL Server</span>
        <span class="badge font-pg">PostgreSQL</span>
        <span class="badge font-sb">Supabase / SQLite</span>
        <span class="badge font-redis">Redis</span>
        <span class="badge">MongoDB</span>
      </div>
    </div>

    <!-- DevOps / Infra Card -->
    <div class="glass-card skill-card">
      <div class="card-header">
        <div class="category-icon devops-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <h4>DevOps & Infra</h4>
      </div>
      <div class="skills-badges">
        <span class="badge font-docker">Docker</span>
        <span class="badge">Linux / VPS</span>
        <span class="badge">Traefik</span>
        <span class="badge">Cloudflare</span>
        <span class="badge">Dokploy</span>
        <span class="badge">Kubernetes</span>
        <span class="badge font-git">Git / GitHub Actions</span>
        <span class="badge">CI / CD</span>
      </div>
    </div>

    <!-- Integraciones Card -->
    <div class="glass-card skill-card">
      <div class="card-header">
        <div class="category-icon integration-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a2 2 0 002 2h3a2 2 0 012 2v3a2 2 0 002 2 2 2 0 110 4h-1a2 2 0 00-2 2v3a2 2 0 01-2 2h-3a2 2 0 00-2-2v-1a2 2 0 11-4 0v-1a2 2 0 00-2-2H4a2 2 0 01-2-2v-3a2 2 0 00-2-2V9a2 2 0 012-2h3a2 2 0 002-2V4z"/>
          </svg>
        </div>
        <h4>Integraciones</h4>
      </div>
      <div class="skills-badges">
        <span class="badge font-wa">WhatsApp Business API</span>
        <span class="badge">Chatwoot</span>
        <span class="badge font-mp">Mercado Pago</span>
        <span class="badge font-ai">OpenAI API</span>
        <span class="badge">n8n</span>
        <span class="badge">API Talana</span>
      </div>
    </div>
  </div>

  <!-- Education Section -->
  <div class="glass-card education-card">
    <h3>Educación & Formación</h3>
    <div class="education-timeline">
      <div class="education-item">
        <div class="edu-dot"></div>
        <div class="edu-info">
          <h5>Ingeniería en Software</h5>
          <p class="school">Universidad Autónoma de Occidente</p>
          <span class="edu-date">2022 – 2025</span>
        </div>
      </div>
      <div class="education-item">
        <div class="edu-dot"></div>
        <div class="edu-info">
          <h5>Desarrollo Web Completo (HTML5, CSS3, JS, PHP, MySQL)</h5>
          <p class="school">Udemy (Plataforma Global)</p>
          <span class="edu-date">2021</span>
        </div>
      </div>
      <div class="education-item">
        <div class="edu-dot"></div>
        <div class="edu-info">
          <h5>Aprende Vue + Firebase</h5>
          <p class="school">Udemy (Plataforma Global)</p>
          <span class="edu-date">2021</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem 1.5rem;
  }

  /* Section Title styling */
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .icon-brackets {
    font-family: var(--font-headers);
    color: var(--primary-light);
    font-size: 1.6rem;
    font-weight: 800;
  }

  .section-title h2 {
    font-size: 1.8rem;
    color: var(--text-main);
    letter-spacing: -0.5px;
  }

  /* Profile Card styling */
  .profile-card {
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .profile-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .profile-card p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .stats-row {
    display: flex;
    gap: 2.5rem;
    border-top: 1px dashed rgba(109, 40, 217, 0.15);
    padding-top: 1.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: var(--font-headers);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--primary-light);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .skill-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .card-header h4 {
    font-size: 1.1rem;
    color: var(--text-main);
  }

  .category-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--border-radius-sm);
    display: flex;
    justify-content: center;
    align-items: center;
    color: #FFFFFF;
  }

  .category-icon svg {
    width: 20px;
    height: 20px;
  }

  .front-icon { background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%); }
  .back-icon { background: linear-gradient(135deg, #10B981 0%, #047857 100%); }
  .devops-icon { background: linear-gradient(135deg, #6366F1 0%, #4338CA 100%); }
  .integration-icon { background: linear-gradient(135deg, #EC4899 0%, #BE185D 100%); }

  .skills-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: var(--border-radius-full);
    background-color: var(--white-bg);
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .badge:hover {
    transform: scale(1.05);
    border-color: var(--primary-light);
    color: var(--primary-light);
    box-shadow: 0 4px 8px rgba(109, 40, 217, 0.05);
  }

  /* Branded Badge Accents */
  .badge.font-ts { border-color: rgba(49, 120, 198, 0.3); background-color: rgba(49, 120, 198, 0.03); color: #3178C6; }
  .badge.font-react { border-color: rgba(97, 218, 251, 0.4); background-color: rgba(97, 218, 251, 0.03); color: #007D9C; }
  .badge.font-next { border-color: rgba(0, 0, 0, 0.2); background-color: rgba(0, 0, 0, 0.02); color: #000000; }
  .badge.font-rn { border-color: rgba(78, 48, 148, 0.3); background-color: rgba(78, 48, 148, 0.03); color: #4E3094; }
  .badge.font-node { border-color: rgba(63, 142, 60, 0.3); background-color: rgba(63, 142, 60, 0.03); color: #3F8E3C; }
  .badge.font-cs { border-color: rgba(145, 48, 147, 0.3); background-color: rgba(145, 48, 147, 0.03); color: #913093; }
  .badge.font-py { border-color: rgba(55, 118, 171, 0.3); background-color: rgba(55, 118, 171, 0.03); color: #3776AB; }
  .badge.font-sql { border-color: rgba(204, 41, 44, 0.3); background-color: rgba(204, 41, 44, 0.03); color: #CC292C; }
  .badge.font-pg { border-color: rgba(51, 103, 145, 0.3); background-color: rgba(51, 103, 145, 0.03); color: #336791; }
  .badge.font-sb { border-color: rgba(60, 188, 129, 0.3); background-color: rgba(60, 188, 129, 0.03); color: #3CBC81; }
  .badge.font-redis { border-color: rgba(216, 44, 32, 0.3); background-color: rgba(216, 44, 32, 0.03); color: #D82C20; }
  .badge.font-docker { border-color: rgba(20, 137, 203, 0.3); background-color: rgba(20, 137, 203, 0.03); color: #1489CB; }
  .badge.font-git { border-color: rgba(240, 80, 50, 0.3); background-color: rgba(240, 80, 50, 0.03); color: #F05032; }
  .badge.font-wa { border-color: rgba(37, 211, 102, 0.4); background-color: rgba(37, 211, 102, 0.03); color: #1E824A; }
  .badge.font-mp { border-color: rgba(0, 158, 227, 0.4); background-color: rgba(0, 158, 227, 0.03); color: #009EE3; }
  .badge.font-ai { border-color: rgba(16, 163, 127, 0.4); background-color: rgba(16, 163, 127, 0.03); color: #10A37F; }

  /* Education Card styling */
  .education-card {
    padding: 2rem;
  }

  .education-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .education-timeline {
    position: relative;
    border-left: 2px solid rgba(109, 40, 217, 0.1);
    padding-left: 1.5rem;
    margin-left: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .education-item {
    position: relative;
  }

  .edu-dot {
    position: absolute;
    left: calc(-1.5rem - 6px - 1px);
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 2px solid var(--primary-light);
    box-shadow: 0 0 8px rgba(124, 58, 237, 0.2);
  }

  .edu-info h5 {
    font-size: 1rem;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .edu-info .school {
    font-size: 0.85rem;
    color: var(--primary-light);
    font-weight: 500;
  }

  .edu-info .edu-date {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--card-border);
    padding: 0.2rem 0.5rem;
    border-radius: var(--border-radius-sm);
    margin-top: 0.4rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .stats-row {
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .profile-card {
      padding: 1.5rem;
    }

    .education-card {
      padding: 1.5rem;
    }
  }
</style>
