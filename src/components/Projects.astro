---
// Projects.astro - Showcasing Rogelio's main projects with high-quality visual cards
---

<section class="projects-container" id="proyectos">
  <!-- Section Title -->
  <div class="section-title">
    <span class="icon-brackets">&lt;/&gt;</span>
    <h2>Proyectos Destacados</h2>
  </div>

  <div class="projects-grid">
    <!-- Project 1: DentaFlow -->
    <div class="glass-card project-card">
      <div class="project-header">
        <div class="project-icon saas-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <span class="project-tag saas-tag">SaaS Multi-tenant</span>
      </div>
      <div class="project-body">
        <h3>DentaFlow <span class="arrow">↗</span></h3>
        <p class="project-description">
          SaaS multi-tenant robust diseñado para la gestión integral de clínicas dentales. Cuenta con módulos de agendamiento de citas, recordatorios automáticos automatizados mediante WhatsApp Business API y un sistema de suscripciones recurrente integrado con Mercado Pago.
        </p>
      </div>
      <div class="project-footer">
        <div class="tech-tags">
          <span>Next.js</span>
          <span>SQL Server</span>
          <span>Node.js</span>
          <span>WhatsApp API</span>
        </div>
      </div>
    </div>

    <!-- Project 2: Nexo Laboral -->
    <div class="glass-card project-card">
      <div class="project-header">
        <div class="project-icon hr-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 005.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <span class="project-tag hr-tag">Plataforma RRHH</span>
      </div>
      <div class="project-body">
        <h3>Nexo Laboral <span class="arrow">↗</span></h3>
        <p class="project-description">
          Sistema avanzado de cumplimiento laboral y recursos humanos para el mercado chileno. Implementa roles diferenciados para supervisores, trabajadores y contratistas. Cuenta con una sincronización bidireccional y robusta con la API gubernamental de Talana.
        </p>
      </div>
      <div class="project-footer">
        <div class="tech-tags">
          <span>Next.js</span>
          <span>Supabase</span>
          <span>PostgreSQL</span>
          <span>Talana API</span>
        </div>
      </div>
    </div>

    <!-- Project 3: PaletteSnap -->
    <div class="glass-card project-card">
      <div class="project-header">
        <div class="project-icon design-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
          </svg>
        </div>
        <span class="project-tag open-source-tag">Open Source</span>
      </div>
      <div class="project-body">
        <a href="https://github.com/RogelioLB/palettesnap" target="_blank" rel="noopener noreferrer">
          <h3>PaletteSnap <span class="arrow">↗</span></h3>
        </a>
        <p class="project-description">
          Extractor de paletas de colores dominantes a partir de imágenes cargadas. Soporta formatos HEX, RGB y HSL, con traducción automática de nombres de colores a español. Permite exportar la paleta final como código CSS o imagen PNG limpia.
        </p>
      </div>
      <div class="project-footer">
        <div class="tech-tags">
          <span>Astro</span>
          <span>TailwindCSS</span>
          <span>TypeScript</span>
          <span>Canvas API</span>
        </div>
      </div>
    </div>

    <!-- Project 4: node-yt-converter -->
    <div class="glass-card project-card">
      <div class="project-header">
        <div class="project-icon npm-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
          </svg>
        </div>
        <span class="project-tag npm-tag">Librería NPM</span>
      </div>
      <div class="project-body">
        <a href="https://github.com/RogelioLB/node-yt-converter" target="_blank" rel="noopener noreferrer">
          <h3>node-yt-converter <span class="arrow">↗</span></h3>
        </a>
        <p class="project-description">
          Librería publicada en el registro oficial de NPM desarrollada completamente en TypeScript. Permite realizar la conversión rápida de videos de YouTube a archivos de audio MP3 y video MP4 de forma local y programática. Cuenta con 13 estrellas en GitHub.
        </p>
      </div>
      <div class="project-footer">
        <div class="tech-tags">
          <span>TypeScript</span>
          <span>Node.js</span>
          <span>NPM Registry</span>
          <span>FFmpeg</span>
        </div>
      </div>
    </div>

    <!-- Project 5: Alfri Chapas y Herrajes -->
    <div class="glass-card project-card">
      <div class="project-header">
        <div class="project-icon shopify-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <span class="project-tag shopify-tag">Migración e-commerce</span>
      </div>
      <div class="project-body">
        <a href="https://alfri.mx" target="_blank" rel="noopener noreferrer">
          <h3>Alfri Chapas y Herrajes <span class="arrow">↗</span></h3>
        </a>
        <p class="project-description">
          Migración completa de la tienda e-commerce de la plataforma Shopify a MedusaJS para un cliente importante en México. Desarrollo a medida de scripts en Node.js para la migración íntegra de productos, variantes e imágenes a un almacenamiento S3 con MinIO.
        </p>
      </div>
      <div class="project-footer">
        <div class="tech-tags">
          <span>MedusaJS</span>
          <span>Next.js</span>
          <span>MinIO (S3)</span>
          <span>PostgreSQL</span>
        </div>
      </div>
    </div>

    <!-- Project 6: FinanzIA -->
    <div class="glass-card project-card">
      <div class="project-header">
        <div class="project-icon mobile-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </div>
        <span class="project-tag mobile-tag">App Móvil IA</span>
      </div>
      <div class="project-body">
        <a href="https://github.com/RogelioLB/finanzIA" target="_blank" rel="noopener noreferrer">
          <h3>FinanzIA <span class="arrow">↗</span></h3>
        </a>
        <p class="project-description">
          Aplicación móvil nativa personal para el control inteligente de finanzas, deudas, suscripciones y tarjetas de crédito. Integra un chat inteligente de soporte financiero alimentado por un modelo de lenguaje de IA (LLM) que analiza el contexto de los gastos.
        </p>
      </div>
      <div class="project-footer">
        <div class="tech-tags">
          <span>React Native</span>
          <span>Expo</span>
          <span>ExpressJS</span>
          <span>SQLite</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem 1.5rem;
  }

  /* Title styling */
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .icon-brackets {
    font-family: var(--font-headers);
    color: var(--primary-light);
    font-size: 1.6rem;
    font-weight: 800;
  }

  .section-title h2 {
    font-size: 1.8rem;
    color: var(--text-main);
    letter-spacing: -0.5px;
  }

  /* Projects grid layout */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
  }

  /* Card styling */
  .project-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: transparent;
    transition: background 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
  }

  .project-card:hover::before {
    background: linear-gradient(90deg, var(--primary-light), #D8B4FE);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  /* Icons inside project headers */
  .project-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--border-radius-sm);
    display: flex;
    justify-content: center;
    align-items: center;
    color: #FFFFFF;
  }

  .project-icon svg {
    width: 22px;
    height: 22px;
  }

  .saas-icon { background: linear-gradient(135deg, #7C3AED 0%, #A855F7 100%); }
  .hr-icon { background: linear-gradient(135deg, #0284C7 0%, #0ea5e9 100%); }
  .design-icon { background: linear-gradient(135deg, #10B981 0%, #34D399 100%); }
  .npm-icon { background: linear-gradient(135deg, #EF4444 0%, #F87171 100%); }
  .shopify-icon { background: linear-gradient(135deg, #15803D 0%, #22C55E 100%); }
  .mobile-icon { background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%); }

  /* Badge styling */
  .project-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--border-radius-full);
    text-transform: uppercase;
    letter-spacing: 0.2px;
  }

  .saas-tag { background-color: rgba(124, 58, 237, 0.1); color: #7C3AED; }
  .hr-tag { background-color: rgba(2, 132, 199, 0.1); color: #0284C7; }
  .open-source-tag { background-color: rgba(16, 185, 129, 0.1); color: #10B981; }
  .npm-tag { background-color: rgba(239, 68, 68, 0.1); color: #EF4444; }
  .shopify-tag { background-color: rgba(21, 128, 61, 0.1); color: #15803D; }
  .mobile-tag { background-color: rgba(245, 158, 11, 0.1); color: #D97706; }

  /* Card body text */
  .project-body {
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .project-body h3 {
    font-size: 1.2rem;
    color: var(--text-main);
    margin-bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .project-card:hover .project-body h3 {
    color: var(--primary-light);
  }

  .arrow {
    font-size: 0.9rem;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.2s ease;
  }

  .project-card:hover .arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .project-description {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Card footer and tech tags */
  .project-footer {
    border-top: 1px solid var(--card-border);
    padding-top: 1rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-tags span {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background-color: var(--white-bg);
    border: 1px solid var(--card-border);
    color: var(--text-muted);
  }

  /* Responsiveness */
  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .project-card {
      padding: 1.5rem;
    }
  }
</style>
