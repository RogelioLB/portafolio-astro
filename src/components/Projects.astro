---
// Projects.astro — F1 Bento feature grid: irregular spans, hairline tiles, single accent.
// Each card title links to its dedicated case-study page (SEO-friendly internal linking).
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { useTranslations, projectPath, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const allImages = import.meta.glob('../assets/projects/*/*.{png,jpg,webp}', { eager: true });
const imagesBySlug = Object.entries(allImages).reduce((acc, [path, mod]) => {
  const m = path.match(/\/projects\/([^/]+)\//);
  if (!m) return acc;
  (acc[m[1]] ??= []).push({ src: mod.default, name: path.split('/').pop() });
  return acc;
}, {});
for (const slug of Object.keys(imagesBySlug)) {
  imagesBySlug[slug].sort((a, b) =>
    a.name.localeCompare(b.name, undefined, { numeric: true })
  );
}

const imageWidths = [320, 480, 640];
const imageSizes = '(max-width: 600px) 50vw, 320px';
const imageQuality = 75;
---

<section class="projects" id="proyectos">
  <div class="section-head">
    <span class="mono-label">{t('projects.eyebrow')}</span>
    <h2>{t('projects.title')}</h2>
  </div>

  <div class="bento">
    {projects.map((project) => (
      <a href={projectPath(lang, project.slug)} class={`tile project-tile reveal span-${project.span}`}>
        {(imagesBySlug[project.slug] ?? []).length > 0 && (
          <div class="gallery">
            {imagesBySlug[project.slug].slice(0, 4).map((img, i) => (
              <Image
                src={img.src}
                alt={`${project.name} — ${lang === 'en' ? 'view' : 'vista'} ${i + 1}`}
                widths={imageWidths}
                sizes={imageSizes}
                quality={imageQuality}
                loading="lazy"
                decoding="async"
                class="gallery-img"
              />
            ))}
          </div>
        )}
        <div class="project-body">
          <span class="mono-label project-tag">{project.tag[lang]}</span>
          <h3>{project.name} <span class="arrow">↗</span></h3>
          <p class="project-description">{project.summary[lang]}</p>
          <div class="tech-tags">
            {project.tech.map((tc) => <span>{tc}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .projects {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg) var(--space-3xl);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xl);
  }

  .section-head h2 {
    font-size: var(--text-2xl);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .project-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .span-2 {
    grid-column: span 2;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
    aspect-ratio: 2 / 1;
    background: var(--color-paper-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .gallery:has(> :only-child) {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .project-tag {
    color: var(--color-accent);
  }

  .project-body h3 {
    font-size: var(--text-md);
  }

  .project-tile:hover h3 {
    color: var(--color-accent);
  }

  .arrow {
    font-size: 0.85em;
    color: var(--color-ink-muted);
  }

  .project-description {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-2xs);
  }

  .tech-tags span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .span-2 {
      grid-column: span 2;
    }
  }

  @media (max-width: 34rem) {
    .bento {
      grid-template-columns: 1fr;
    }

    .span-2 {
      grid-column: span 1;
    }
  }
</style>
