---
// Hero.astro — H2 Split diptych: headline + lede left, live "API response" code card right.
// Cobalt signature move 4 (code as hero), rebuilt without fake window chrome (gate 47).
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const lede =
  lang === 'en'
    ? { pre: 'Full-stack development with ', b1: 'JavaScript/TypeScript', mid: ': multi-tenant systems, payment integrations with ', b2: 'Mercado Pago', mid2: ', and automations with ', b3: 'WhatsApp Business API', post: ', from the database to the interface.' }
    : { pre: 'Desarrollo full-stack con ', b1: 'JavaScript/TypeScript', mid: ': sistemas multi-tenant, integraciones de pago con ', b2: 'Mercado Pago', mid2: ' y automatizaciones con ', b3: 'WhatsApp Business API', post: ', desde la base de datos hasta la interfaz.' };
---

<header class="hero reveal">
  <div class="hero-top">
    <div class="identity">
      <img src="/avatar.png" alt="Rogelio López" class="avatar" width="44" height="44" />
      <span class="mono-label identity-label">Rogelio López · {t('hero.eyebrow')}</span>
    </div>

    <div class="hero-demo">
      <div class="code-card">
        <div class="code-card-head">
          <span class="code-method">GET /api/rogelio</span>
          <span class="code-status">200 OK</span>
        </div>
        <pre class="code-body"><code><span class="tok-punct">{"{"}</span>
  <span class="tok-key">"role"</span><span class="tok-punct">:</span> <span class="tok-string">"Full-Stack Engineer"</span><span class="tok-punct">,</span>
  <span class="tok-key">"location"</span><span class="tok-punct">:</span> <span class="tok-string">"{t('hero.code.location')}"</span><span class="tok-punct">,</span>
  <span class="tok-key">"experience_years"</span><span class="tok-punct">:</span> <span class="tok-num">4</span><span class="tok-punct">,</span>
  <span class="tok-key">"stack"</span><span class="tok-punct">:</span> <span class="tok-punct">[</span><span class="tok-string">"TypeScript"</span><span class="tok-punct">,</span> <span class="tok-string">"Node.js"</span><span class="tok-punct">,</span> <span class="tok-string">"Next.js"</span><span class="tok-punct">,</span> <span class="tok-string">"Docker"</span><span class="tok-punct">]</span><span class="tok-punct">,</span>
  <span class="tok-key">"status"</span><span class="tok-punct">:</span> <span class="tok-string tok-accent">"available_for_hire"</span>
<span class="tok-punct">{"}"}</span></code></pre>
      </div>
    </div>
  </div>

  <div class="hero-copy">
    <h1>{t('hero.headline')}</h1>

    <p class="lede">
      {lede.pre}<strong>{lede.b1}</strong>{lede.mid}<strong>{lede.b2}</strong>{lede.mid2}<strong>{lede.b3}</strong>{lede.post}
    </p>

    <div class="hero-actions">
      <a href="#contacto" class="btn btn-primary">{t('hero.cta.contact')}</a>
      <a href="#proyectos" class="btn btn-outline">{t('hero.cta.projects')}</a>
      <a href="https://github.com/RogelioLB" target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="GitHub de Rogelio">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
      </a>
      <a href="https://twitter.com/RogelioLB" target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="Twitter de Rogelio">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>
  </div>
</header>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) var(--space-2xl);
  }

  .hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }

  .identity {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-2xs);
    min-width: 0;
    flex: 1 1 16rem;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-rule);
    flex-shrink: 0;
  }

  .identity-label {
    color: var(--color-ink-muted);
    max-width: 16rem;
  }

  .hero-demo {
    flex-shrink: 0;
    width: min(100%, 28rem);
  }

  .hero-copy h1 {
    font-size: var(--text-display-s);
    margin-bottom: var(--space-lg);
    max-width: 34ch;
  }

  .lede {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }

  .lede strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: var(--color-ink-muted);
    border-radius: var(--radius-control);
    transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }

  .icon-link:hover {
    color: var(--color-accent);
    background: var(--color-paper-2);
  }

  /* Code card — typographic frame, no fake window chrome */
  .code-card {
    background: var(--color-graphite);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-card);
    box-shadow: 0 1px 2px oklch(24% 0.02 258 / 0.05);
    overflow: hidden;
  }

  .code-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-rule-2);
  }

  .code-method {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-on-dark-muted);
  }

  .code-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .code-body {
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--color-ink-on-dark-muted);
  }

  .tok-key { color: var(--color-ink-on-dark); }
  .tok-string { color: oklch(78% 0.12 152); }
  .tok-num { color: oklch(78% 0.14 70); }
  .tok-punct { color: var(--color-ink-on-dark-muted); opacity: 0.6; }
  .tok-accent { color: var(--color-accent); }

  @media (max-width: 60rem) {
    .hero {
      padding-top: var(--space-2xl);
    }

    .hero-copy h1 {
      max-width: none;
    }
  }

  @media (max-width: 26rem) {
    .code-body {
      font-size: 0.72rem;
    }
  }
</style>
