---
// Services.astro — F1 Bento (3 tiles). Keyword-targeted service framing:
// "hire a full-stack developer" / "WhatsApp Business API integration" / "Shopify migration".
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    title: t('services.fullstack.title'),
    body: t('services.fullstack.body'),
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    title: t('services.whatsapp.title'),
    body: t('services.whatsapp.body'),
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
  {
    title: t('services.migration.title'),
    body: t('services.migration.body'),
    icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  },
];
---

<section class="services" id="servicios">
  <div class="section-head">
    <span class="mono-label">{t('services.eyebrow')}</span>
    <h2>{t('services.title')}</h2>
  </div>

  <div class="bento">
    {services.map((s) => (
      <div class="tile service-tile reveal">
        <svg class="service-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
        </svg>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
        <a href="#contacto" class="service-link">
          {t('services.cta')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .services {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xl);
  }

  .section-head h2 {
    font-size: var(--text-2xl);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .service-tile {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .service-icon {
    width: 22px;
    height: 22px;
    color: var(--color-ink-muted);
  }

  .service-tile:hover .service-icon {
    color: var(--color-accent);
  }

  .service-tile h3 {
    font-size: var(--text-md);
  }

  .service-tile p {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    margin-top: var(--space-xs);
  }

  .service-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: 1fr;
    }
  }
</style>
