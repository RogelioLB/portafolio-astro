---
// Nav.astro — N13 Inline ⌘K search pill. Bordered flush bar (Cobalt signature move 5).
import { projects } from '../data/projects';
import { useTranslations, projectPath, homePath, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
  altPath?: string;
}
const { lang = 'es', altPath } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const sectionsGroup = lang === 'en' ? 'Sections' : 'Secciones';
const projectsGroup = lang === 'en' ? 'Projects' : 'Proyectos';
const linksGroup = lang === 'en' ? 'Links' : 'Enlaces';

const commands = [
  { group: sectionsGroup, label: t('nav.about'), href: `${home}#sobre-mi` },
  { group: sectionsGroup, label: t('nav.experience'), href: `${home}#experiencia` },
  { group: sectionsGroup, label: t('nav.projects'), href: `${home}#proyectos` },
  { group: sectionsGroup, label: t('nav.contact'), href: `${home}#contacto` },
  ...projects.map((p) => ({ group: projectsGroup, label: p.name, href: projectPath(lang, p.slug) })),
  { group: linksGroup, label: 'GitHub', href: 'https://github.com/RogelioLB' },
  { group: linksGroup, label: 'LinkedIn', href: 'https://linkedin.com/in/rogeliolb' },
];

const otherLangHref = altPath ?? (lang === 'en' ? '/' : '/en');
---

<nav class="nav" id="site-nav">
  <div class="nav-inner">
    <a href={home} class="wordmark">rogeliolb<span class="wordmark-dot">.dev</span></a>

    <div class="nav-links">
      <a href={`${home}#sobre-mi`}>{t('nav.about')}</a>
      <a href={`${home}#proyectos`}>{t('nav.projects')}</a>
      <a href={`${home}#experiencia`}>{t('nav.experience')}</a>
    </div>

    <div class="nav-actions">
      <a href={otherLangHref} class="lang-switch" aria-label={t('nav.lang.aria')}>{t('nav.lang.switch')}</a>
      <button type="button" class="cmdk-trigger" id="cmdk-trigger" aria-haspopup="dialog" aria-controls="cmdk-modal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        <span class="cmdk-trigger-label">{t('nav.search')}</span>
        <kbd class="cmdk-kbd">⌘K</kbd>
      </button>
      <a href={`${home}#contacto`} class="btn btn-primary">{t('nav.contact')}</a>
    </div>
  </div>
</nav>

<div class="cmdk-overlay" id="cmdk-overlay" hidden>
  <div class="cmdk-modal" id="cmdk-modal" role="dialog" aria-modal="true" aria-label={t('nav.search')}>
    <div class="cmdk-search-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" id="cmdk-input" class="cmdk-input" placeholder={t('nav.search.placeholder')} autocomplete="off" />
      <kbd class="cmdk-kbd">Esc</kbd>
    </div>
    <div class="cmdk-results" id="cmdk-results" role="listbox">
      {commands.map((c, i) => (
        <a
          href={c.href}
          class="cmdk-result"
          role="option"
          data-group={c.group}
          data-label={c.label.toLowerCase()}
          data-index={i}
        >
          <span class="cmdk-result-group">{c.group}</span>
          <span class="cmdk-result-label">{c.label}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('cmdk-trigger') as HTMLButtonElement;
  const overlay = document.getElementById('cmdk-overlay') as HTMLDivElement;
  const input = document.getElementById('cmdk-input') as HTMLInputElement;
  const results = document.getElementById('cmdk-results') as HTMLDivElement;
  const nav = document.getElementById('site-nav') as HTMLElement;

  let activeIndex = 0;

  function visibleItems(): HTMLAnchorElement[] {
    return Array.from(results.querySelectorAll<HTMLAnchorElement>('.cmdk-result:not([hidden])'));
  }

  function setActive(index: number) {
    const items = visibleItems();
    items.forEach((el) => el.classList.remove('is-active'));
    if (!items.length) return;
    activeIndex = (index + items.length) % items.length;
    items[activeIndex].classList.add('is-active');
    items[activeIndex].scrollIntoView({ block: 'nearest' });
  }

  function openCmdk() {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    filter('');
    input.focus();
    activeIndex = 0;
    setActive(0);
  }

  function closeCmdk() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    trigger.focus();
  }

  function filter(query: string) {
    const q = query.trim().toLowerCase();
    results.querySelectorAll<HTMLAnchorElement>('.cmdk-result').forEach((el) => {
      const match = !q || el.dataset.label!.includes(q) || el.dataset.group!.toLowerCase().includes(q);
      el.hidden = !match;
    });
    activeIndex = 0;
    setActive(0);
  }

  trigger.addEventListener('click', openCmdk);

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeCmdk();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.hidden ? openCmdk() : closeCmdk();
      return;
    }
    if (overlay.hidden) return;
    if (e.key === 'Escape') {
      closeCmdk();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === 'Enter') {
      const items = visibleItems();
      if (items[activeIndex]) {
        e.preventDefault();
        items[activeIndex].click();
      }
    }
  });

  input.addEventListener('input', () => filter(input.value));

  results.querySelectorAll('.cmdk-result').forEach((el) => {
    el.addEventListener('click', () => closeCmdk());
  });

  window.addEventListener('scroll', () => {
    nav.classList.toggle('is-scrolled', window.scrollY > 8);
  }, { passive: true });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in oklch, var(--color-paper) 95%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-medium) var(--ease-out);
  }

  .nav.is-scrolled {
    border-bottom-color: var(--color-rule);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .wordmark-dot {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: var(--space-lg);
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    transition: color var(--dur-short) var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    transition: border-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }

  .lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cmdk-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: border-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }

  .cmdk-trigger:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .cmdk-trigger-label {
    font-size: var(--text-sm);
  }

  .cmdk-kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  /* Command palette */
  .cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: color-mix(in oklch, var(--color-graphite) 55%, transparent);
    backdrop-filter: blur(4px);
    align-items: flex-start;
    justify-content: center;
    padding: 12vh var(--space-lg) var(--space-lg);
  }

  .cmdk-overlay[hidden] {
    display: none;
  }

  .cmdk-overlay:not([hidden]) {
    display: flex;
  }

  .cmdk-modal {
    width: 100%;
    max-width: 34rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    box-shadow: 0 20px 40px oklch(24% 0.02 258 / 0.18);
    overflow: hidden;
  }

  .cmdk-search-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  .cmdk-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .cmdk-results {
    max-height: 20rem;
    overflow-y: auto;
    padding: var(--space-xs);
  }

  .cmdk-result {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-control);
    color: var(--color-ink-2);
  }

  .cmdk-result[hidden] {
    display: none;
  }

  .cmdk-result.is-active,
  .cmdk-result:hover {
    background: var(--color-paper-2);
  }

  .cmdk-result-group {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    min-width: 5.5rem;
  }

  .cmdk-result-label {
    font-size: var(--text-sm);
  }

  @media (max-width: 60rem) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .cmdk-trigger-label {
      display: none;
    }
    .btn-primary {
      padding-inline: var(--space-sm);
    }
  }
</style>
