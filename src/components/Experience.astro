---
// Experience.astro — the one dark graphite band (Cobalt signature move 8).
import { experience } from '../data/experience';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="experience" id="experiencia">
  <div class="experience-inner">
    <div class="section-head">
      <span class="mono-label">{t('experience.eyebrow')}</span>
      <h2>{t('experience.title')}</h2>
    </div>

    <div class="trail">
      {experience.map((node) => (
        <div class="node reveal">
          <div class="node-marker">
            <span class={`dot ${node.active ? 'dot-active' : ''}`}></span>
          </div>
          <div class="node-body">
            <div class="node-head">
              <div>
                <h3>{node.role[lang]}</h3>
                <span class="company">{node.company}</span>
              </div>
              <span class={`date-chip ${node.active ? 'date-active' : ''}`}>{node.date[lang]}</span>
            </div>
            <p class="node-intro">{node.intro[lang]}</p>

            {node.achievements && (
              <ul class="achievements">
                {node.achievements.map((a) => <li set:html={a[lang]} />)}
              </ul>
            )}

            {node.tech && (
              <div class="mini-badges">
                {node.tech.map((tech) => <span>{tech}</span>)}
              </div>
            )}

            {node.subProjects && (
              <div class="sub-projects">
                {node.subProjects.map((sp) => (
                  <div class="sub-project">
                    <h4>{sp.title[lang]} <span class="sub-client">· {sp.client}</span></h4>
                    <p>{sp.description[lang]}</p>
                    <div class="mini-badges">
                      {sp.tech.map((tech) => <span>{tech}</span>)}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    background: var(--color-graphite);
    width: 100%;
    margin-inline: calc(50% - 50vw);
    padding-block: var(--space-3xl);
    color: var(--color-ink-on-dark-muted);
  }

  .experience-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-inline: var(--space-lg);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xl);
  }

  .experience .mono-label {
    color: var(--color-accent);
  }

  .experience h2 {
    color: var(--color-ink-on-dark);
    font-size: var(--text-2xl);
  }

  .trail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .node {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--space-md);
  }

  .node-marker {
    display: flex;
    justify-content: center;
    padding-top: var(--space-3xs);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-graphite-2);
    border: 2px solid var(--color-rule-2);
  }

  .dot-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .node-body {
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
  }

  .node-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .node-head h3 {
    color: var(--color-ink-on-dark);
    font-size: var(--text-md);
  }

  .company {
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .date-chip {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule-2);
    color: var(--color-ink-on-dark-muted);
    white-space: nowrap;
  }

  .date-active {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .node-intro {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .achievements {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .achievements li {
    font-size: var(--text-sm);
    line-height: 1.55;
    padding-left: var(--space-md);
    position: relative;
  }

  .achievements li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .achievements :global(strong) {
    color: var(--color-ink-on-dark);
    font-weight: 600;
  }

  .mini-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule-2);
  }

  .mini-badges span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule-2);
    color: var(--color-ink-on-dark-muted);
  }

  .sub-projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-rule-2);
  }

  .sub-project h4 {
    font-size: var(--text-sm);
    color: var(--color-ink-on-dark);
    margin-bottom: var(--space-2xs);
    font-weight: 500;
  }

  .sub-client {
    color: var(--color-accent);
    font-weight: 400;
  }

  .sub-project p {
    font-size: var(--text-xs);
    line-height: 1.55;
    margin-bottom: var(--space-sm);
  }

  .sub-project .mini-badges {
    border-top: none;
    padding-top: 0;
  }

  @media (max-width: 40rem) {
    .node-head {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>
