          R(x + 5, y - 30 - up, 2, 7, P.hood);
          R(x - 7, y - 32 - up, 2, 2, P.skin);
          R(x + 5, y - 32 - up, 2, 2, P.skin);
        }
      }
      if (hovered && !walking) {
        const w = reduceMotion ? 0 : Math.floor(t / 220) % 2;
        R(x + 5, y - 22 - w, 2, 8, P.hood);
        R(x + 5, y - 25 - w, 3, 3, P.skin);
        say(C.hello, x, y - 44);
      }
    };

    // Dibujo espejo para las vistas laterales.
    const drawPerson = (x: number, y: number, dir: Dir, frame: number, walking: boolean) => {
      const s = dir === 'left' ? -1 : 1;
      const M = (dx: number, dy: number, w: number, h: number, c: string) =>
        s === 1 ? R(x + dx, y + dy, w, h, c) : R(x - dx - w, y + dy, w, h, c);
      const blink = S.t < S.blinkUntil;
      R(x - 6, y - 1, 12, 3, 'rgba(0,0,0,0.25)');

      if (dir === 'up' || dir === 'down') {
        const lo = frame === 1 ? -1 : 0;
        const ro = frame === 3 ? -1 : 0;
        R(x - 4, y - 6, 3, 5 + lo, P.jeans);
        R(x + 1, y - 6, 3, 5 + ro, P.jeans);
        R(x - 4, y - 1 + lo, 3, 1, P.shoe);
        R(x + 1, y - 1 + ro, 3, 1, P.shoe);
        const a = walking ? (frame === 1 ? 1 : frame === 3 ? -1 : 0) : 0;
        R(x - 7, y - 13 + a, 2, 7, P.arm);
        R(x + 5, y - 13 - a, 2, 7, P.arm);
        R(x - 7, y - 6 + a, 2, 2, P.skin);
        R(x + 5, y - 6 - a, 2, 2, P.skin);
        R(x - 5, y - 14, 10, 9, P.hood);
        R(x - 5, y - 14, 10, 1, P.hoodHi);
        if (dir === 'down') {
          R(x - 3, y - 9, 6, 2, P.hoodDk);
          R(x - 2, y - 13, 1, 3, '#d8d8e0');
          R(x + 1, y - 13, 1, 3, '#d8d8e0');
          // Cabeza de frente
          R(x - 4, y - 23, 8, 9, P.skin);
          R(x - 3, y - 14, 6, 1, P.skin);
          R(x - 5, y - 20, 1, 2, P.skinDk);
          R(x + 4, y - 20, 1, 2, P.skinDk);
          R(x - 5, y - 27, 10, 5, P.hair);
          R(x - 5, y - 22, 1, 3, P.hair);
          R(x + 4, y - 22, 1, 3, P.hair);
          R(x - 4, y - 28, 2, 1, P.hair);
          R(x, y - 29, 2, 2, P.hair);
          R(x + 3, y - 28, 1, 1, P.hair);
          R(x - 4, y - 22, 3, 1, P.hair);
          R(x + 1, y - 22, 2, 1, P.hair);
          R(x - 3, y - 27, 4, 1, P.hairHi);
          // Lentes
          R(x - 4, y - 20, 3, 1, P.frame);
          R(x + 1, y - 20, 3, 1, P.frame);
          R(x - 4, y - 18, 3, 1, P.frame);
          R(x + 1, y - 18, 3, 1, P.frame);
          R(x - 1, y - 20, 2, 1, P.frame);
          if (blink) {
            R(x - 3, y - 19, 1, 1, P.skinDk);
            R(x + 2, y - 19, 1, 1, P.skinDk);
          } else {
            R(x - 3, y - 19, 1, 1, P.hair);
            R(x + 2, y - 19, 1, 1, P.hair);
          }
          R(x - 1, y - 16, 2, 1, P.mouth);
        } else {
          R(x - 3, y - 14, 6, 3, P.hoodDk);
          R(x - 5, y - 20, 1, 2, P.skinDk);
          R(x + 4, y - 20, 1, 2, P.skinDk);
          R(x - 4, y - 25, 8, 11, P.hair);
          R(x - 5, y - 26, 10, 7, P.hair);
          R(x - 4, y - 28, 2, 2, P.hair);
          R(x, y - 29, 2, 3, P.hair);
          R(x + 3, y - 28, 1, 2, P.hair);
          R(x - 3, y - 25, 5, 1, P.hairHi);
          R(x - 5, y - 19, 1, 1, P.frame);
          R(x + 4, y - 19, 1, 1, P.frame);
        }
      } else {
        // Perfil
        if (walking && frame % 2 === 1) {
          const f = frame === 1;
          M(-4, -6, 3, 5, f ? P.jeansDk : P.jeans);
          M(1, -6, 3, 5, f ? P.jeans : P.jeansDk);
          M(-4, -1, 3, 1, P.shoe);
          M(2, -1, 3, 1, P.shoe);
        } else {
          M(-2, -6, 4, 5, P.jeans);
          M(-2, -1, 5, 1, P.shoe);
        }
        M(-4, -14, 8, 9, P.hood);
        M(-4, -14, 8, 1, P.hoodHi);
        M(-4, -14, 2, 4, P.hoodDk);
        const sw = walking ? (frame === 1 ? 2 : frame === 3 ? -2 : 0) : 0;
        const petting = me.mode === 'act' && me.anim === 'pet';
        if (petting) {
          const pw = Math.floor(S.t / 250) % 2;
          M(0, -12, 8, 2, P.arm);
          M(8, -12 + pw, 2, 2, P.skin);
        } else {
          M(-1 + sw, -13, 2, 7, P.arm);
          M(-1 + sw, -6, 2, 2, P.skin);
        }
        M(-3, -23, 8, 9, P.skin);
        M(-2, -14, 5, 1, P.skin);
        M(5, -19, 1, 1, P.skin);
        M(-4, -27, 9, 5, P.hair);
        M(-5, -24, 4, 8, P.hair);
        M(-3, -28, 2, 1, P.hair);
        M(0, -29, 2, 2, P.hair);
        M(3, -28, 2, 1, P.hair);
        M(1, -22, 4, 2, P.hair);
        M(-2, -20, 2, 2, P.skinDk);
        M(-3, -27, 5, 1, P.hairHi);
        M(1, -20, 4, 1, P.frame);
        M(4, -20, 1, 3, P.frame);
        M(0, -20, 1, 1, P.frame);
        M(3, -19, 1, 1, blink ? P.skinDk : P.hair);
        M(3, -16, 2, 1, P.mouth);
      }
    };

    const drawSeated = (x: number, y: number) => {
      const t = S.t;
      const hovered = S.hover === 'me' || t < S.waveUntil;
      const pose = hovered ? 'wave' : S.phase === 'think' ? 'think' : S.phase === 'deployed' ? 'celebrate' : S.phase === 'typing' ? 'type' : 'idle';
      const tp = pose === 'type' && !reduceMotion ? Math.floor(t / 110) % 2 : 0;
      const bob = pose === 'type' && !reduceMotion && Math.floor(t / 1300) % 5 === 0 ? 1 : 0;

      // Hombros y espalda
      R(x - 7, y - 17, 14, 10, P.hood);
      R(x - 6, y - 18, 12, 1, P.hood);
      R(x - 7, y - 17, 14, 1, P.hoodHi);
      R(x - 4, y - 17, 8, 4, P.hoodDk);
      R(x - 3, y - 17, 6, 1, P.hoodHi);

      // Brazos
      if (pose === 'type' || pose === 'idle') {
        line(x - 6, y - 15, x - 9, y - 21, 3, P.arm);
        line(x - 9, y - 21, x - 7, y - 28, 2, P.arm);
        R(x - 8, y - 31 + tp, 3, 2, P.skin);
        line(x + 6, y - 15, x + 9, y - 21, 3, P.arm);
        line(x + 9, y - 21, x + 7, y - 28, 2, P.arm);
        R(x + 5, y - 30 - tp, 3, 2, P.skin);
      } else if (pose === 'think') {
        line(x - 6, y - 15, x - 9, y - 21, 3, P.arm);
        line(x - 9, y - 21, x - 7, y - 28, 2, P.arm);
        R(x - 8, y - 30, 3, 2, P.skin);
        line(x + 6, y - 15, x + 9, y - 20, 3, P.arm);
        line(x + 9, y - 20, x + 6, y - 25, 2, P.arm);
      } else if (pose === 'celebrate') {
        line(x - 6, y - 16, x - 9, y - 26, 3, P.arm);
        line(x - 9, y - 26, x - 8, y - 35, 2, P.arm);
        R(x - 10, y - 38, 3, 3, P.skin);
        line(x + 6, y - 16, x + 9, y - 26, 3, P.arm);
        line(x + 9, y - 26, x + 8, y - 35, 2, P.arm);
        R(x + 7, y - 38, 3, 3, P.skin);
      } else {
        line(x - 6, y - 15, x - 9, y - 21, 3, P.arm);
        line(x - 9, y - 21, x - 7, y - 28, 2, P.arm);
        R(x - 8, y - 30, 3, 2, P.skin);
      }

      // Cabeza
      const hy = y - bob;
      if (pose === 'wave') {
        // Voltea a ver a quien visita
        R(x - 4, hy - 28, 8, 9, P.skin);
        R(x - 3, hy - 19, 6, 1, P.skin);
        R(x - 5, hy - 32, 10, 5, P.hair);
        R(x - 5, hy - 27, 1, 3, P.hair);
        R(x + 4, hy - 27, 1, 3, P.hair);
        R(x - 4, hy - 33, 2, 1, P.hair);
        R(x, hy - 34, 2, 2, P.hair);
        R(x - 4, hy - 27, 3, 1, P.hair);
        R(x + 1, hy - 27, 2, 1, P.hair);
        R(x - 4, hy - 25, 3, 1, P.frame);
        R(x + 1, hy - 25, 3, 1, P.frame);
        R(x - 4, hy - 23, 3, 1, P.frame);
        R(x + 1, hy - 23, 3, 1, P.frame);
        R(x - 1, hy - 25, 2, 1, P.frame);
        R(x - 3, hy - 24, 1, 1, P.hair);
        R(x + 2, hy - 24, 1, 1, P.hair);
        R(x - 2, hy - 21, 4, 1, P.mouth);
        const w = reduceMotion ? 0 : Math.floor(t / 220) % 2;
        line(x + 6, y - 15, x + 10, y - 22, 3, P.arm);
        line(x + 10, y - 22, x + 11 + w, y - 29, 2, P.arm);
        R(x + 10 + w, y - 33, 3, 4, P.skin);
        say(C.hello, x, y - 50);
      } else {
        R(x - 5, hy - 30, 10, 12, P.hair);
        R(x - 4, hy - 31, 8, 1, P.hair);
        R(x - 4, hy - 33, 2, 2, P.hair);
        R(x, hy - 34, 2, 3, P.hair);
        R(x + 3, hy - 32, 1, 1, P.hair);
        R(x - 3, hy - 29, 5, 1, P.hairHi);
        R(x - 6, hy - 24, 1, 3, P.skinDk);
        R(x + 5, hy - 24, 1, 3, P.skinDk);
        R(x - 5, hy - 25, 1, 1, P.frame);
        R(x + 4, hy - 25, 1, 1, P.frame);
        if (pose === 'think') {
          R(x + 5, y - 27, 3, 3, P.skin);
          const dots = reduceMotion ? 3 : Math.floor(t / 300) % 4;
          bubble(x + 6, y - 48, 16, 9, x + 8);
          for (let i = 0; i < dots; i++) R(x + 9 + i * 4, y - 44, 2, 2, P.ink);
        }
        if (pose === 'celebrate' && !reduceMotion) {
          const f = Math.floor(t / 180) % 2;
          const sp = f ? [[x - 13, y - 40], [x + 11, y - 41], [x, y - 42]] : [[x - 12, y - 36], [x + 12, y - 37], [x - 2, y - 40]];
          sp.forEach(([sx, sy]) => R(sx, sy, 1, 1, '#ffd36b'));
        }
      }
      drawChairBack();
    };

    // ---------- Gato ----------
    const drawCat = () => {
      const t = S.t;
      const x = Math.round(cat.x);
      const y = Math.round(cat.y);
      const awake = t < cat.meowUntil;
      R(x - 6, y - 1, 12, 2, 'rgba(0,0,0,0.22)');
      if (cat.mode === 'sleep' && !awake) {
        const b = !reduceMotion && Math.sin(t / 650) > 0 ? 1 : 0;
        ellipse(x, y - 4, 6, 3 + b, P.cat);
        R(x - 3, y - 7 - b, 1, 3, P.catDk);
        R(x, y - 7 - b, 1, 4, P.catDk);
        R(x + 3, y - 6 - b, 1, 3, P.catDk);
        R(x + 3, y - 6, 5, 5, P.cat);
        R(x + 3, y - 8, 2, 2, P.cat);
        R(x + 6, y - 8, 2, 2, P.cat);
        R(x + 4, y - 4, 1, 1, P.catDk);
        R(x + 6, y - 4, 1, 1, P.catDk);
        R(x - 7, y - 3, 3, 2, P.cat);
        R(x - 6, y - 1, 8, 1, P.cat);
        if (!reduceMotion) {
          for (let i = 0; i < 2; i++) {
            const ph = (t / 2200 + i * 0.5) % 1;
            if (ph < 0.85) text('Z', x + 6 + ph * 6, y - 12 - ph * 12, `rgba(244,241,232,${(1 - ph).toFixed(2)})`);
          }
        }
      } else if (cat.mode === 'walk') {
        const s = cat.dir === 'left' ? -1 : 1;
        const f = !reduceMotion ? Math.floor(cat.walkT / 120) % 2 : 0;
        const M = (dx: number, dy: number, w: number, h: number, c: string) =>
          s === 1 ? R(x + dx, y + dy, w, h, c) : R(x - dx - w, y + dy, w, h, c);
        M(-5, -7, 10, 4, P.cat);
        M(-3, -7, 1, 3, P.catDk);
        M(0, -7, 1, 3, P.catDk);
        M(-4, -3, 1, 2 + f, P.cat);
        M(-2, -3, 1, 3 - f, P.cat);
        M(2, -3, 1, 2 + f, P.cat);
        M(4, -3, 1, 3 - f, P.cat);
        M(-7, -10, 2, 4, P.cat);
        M(4, -11, 5, 5, P.cat);
        M(4, -12, 1, 1, P.cat);
        M(7, -12, 1, 1, P.cat);
        M(7, -9, 1, 1, P.ink);
      } else {
        // Sentado de frente
        R(x - 4, y - 7, 8, 7, P.cat);
        R(x - 2, y - 6, 4, 5, P.catLt);
        R(x + 4, y - 3, 4, 2, P.cat);
        R(x + 7, y - 6, 1, 3, P.cat);
        R(x - 4, y - 13, 8, 6, P.cat);
        R(x - 4, y - 15, 2, 2, P.cat);
        R(x + 2, y - 15, 2, 2, P.cat);
        R(x - 3, y - 14, 1, 1, '#f2a3a3');
        R(x + 2, y - 14, 1, 1, '#f2a3a3');
        const bl = Math.floor(t / 3000) % 4 === 0 && t % 3000 < 160;
        R(x - 3, y - 11, 2, bl ? 1 : 2, '#7fd46a');
        R(x + 1, y - 11, 2, bl ? 1 : 2, '#7fd46a');
        if (!bl) {
          R(x - 2, y - 11, 1, 2, P.ink);
          R(x + 1, y - 11, 1, 2, P.ink);
        }
        R(x, y - 9, 1, 1, '#e58a8a');
      }
      if (awake) say(C.catSays, x, y - 26);
      if (t < cat.heartsUntil && !reduceMotion) {
        for (let i = 0; i < 3; i++) {
          const ph = (t / 900 + i / 3) % 1;
          text('♥', x - 4 + i * 4, y - 14 - ph * 12, `rgba(255,110,140,${(1 - ph).toFixed(2)})`);
        }
      }
    };

    // ---------- Pantalla del monitor ----------
    const drawScreen = () => {
      const p = data.projects[S.proj];
      const x0 = 223;
      const y0 = 29;
      R(x0, y0, 50, 24, '#0f1226');
      R(x0, y0, 50, 6, '#1c2142');
      const label = p.short.length > 9 ? p.short.slice(0, 9) : p.short;
      R(x0 + 1, y0 + 1, textW(label) + 4, 5, '#0f1226');
      text(label, x0 + 3, y0 + 1, '#9fb4ff');
      R(x0 + 44, y0 + 2, 1, 1, '#ff6b6b');
      R(x0 + 46, y0 + 2, 1, 1, '#ffcb6b');
      R(x0 + 48, y0 + 2, 1, 1, '#7fd4a0');
      R(x0, y0 + 6, 4, 18, '#12162e');

      const typed = Math.floor(S.typed);
      const lens = S.code.map((l) => l.toks.length);
      let remaining = typed;
      let curLine = 0;
      for (let i = 0; i < lens.length; i++) {
        if (remaining >= lens[i]) {
          remaining -= lens[i];
          curLine = i + 1;
        } else {
          curLine = i;
          break;
        }
      }
      curLine = Math.min(curLine, S.code.length - 1);
      const panel = S.phase === 'build' || S.phase === 'deployed';
      const visible = panel ? 2 : 5;
      const start = Math.max(0, curLine - (visible - 1));
      let count = 0;
      for (let i = 0; i < start; i++) count += lens[i];
      let cursor: Pt | null = null;
      for (let li = start; li < Math.min(S.code.length, start + visible); li++) {
        const ly = y0 + 8 + (li - start) * 3;
        R(x0 + 1, ly, 2, 1, '#2a3160');
        const ln = S.code[li];
        let lx = x0 + 6 + ln.indent * 3;
        for (const tok of ln.toks) {
          if (count >= typed) break;
          const w = Math.min(tok.w, x0 + 49 - lx);
          if (w > 0) R(lx, ly, w, 2, tok.c);
          lx += tok.w + 1;
          count++;
        }
        if (li === curLine) cursor = [Math.min(lx, x0 + 48), ly];
        if (count >= typed && li >= curLine) break;
      }
      const away = me.mode !== 'sit';
      if (cursor && !panel && Math.floor(S.t / 400) % 2 === 0) R(cursor[0], cursor[1] - 1, 1, 4, '#e8ecff');
      if (panel) {
        R(x0, y0 + 14, 50, 10, '#080a18');
        R(x0, y0 + 14, 50, 1, '#1c2142');
        if (S.phase === 'build') {
          text('> BUILD', x0 + 2, y0 + 15, '#9fb4ff');
          const pr = Math.min(1, S.phaseT / 1600);
          R(x0 + 2, y0 + 21, 46, 2, '#1c2142');
          R(x0 + 2, y0 + 21, Math.round(46 * pr), 2, '#4a7dff');
        } else {
          text('✓ DEPLOYED', x0 + 3, y0 + 15, '#5fe08a');
          R(x0 + 2, y0 + 21, 46, 2, '#5fe08a');
        }
      } else if (away) {
        R(x0 + 30, y0 + 18, 18, 5, '#1c2142');
        text('AFK', x0 + 33, y0 + 18, '#ffcb6b');
      }
    };

    // ---------- Luces ----------
    const drawLights = () => {
      const t = S.t;
      if (S.night) {
        stars.forEach((s) => {
          const on = reduceMotion || Math.sin(t / 700 + s.p) > -0.4;
          if (on && s.x !== 61 && s.x !== 62 && s.y !== 29 && s.y !== 30) R(s.x, s.y, 1, 1, '#f4f1d6');
        });
        disc(48, 21, 3, '#f4f1d6');
        disc(50, 20, 2, '#1a2150');
      }
      drawScreen();

      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      // Haz de la ventana en el piso (+ polvo flotando de día)
      ctx.fillStyle = S.night ? 'rgba(140,170,255,0.05)' : 'rgba(255,236,190,0.11)';
      ctx.beginPath();
      ctx.moveTo(39, 62);
      ctx.lineTo(85, 62);
      ctx.lineTo(128, 150);
      ctx.lineTo(82, 150);
      ctx.closePath();
      ctx.fill();
      if (!S.night && !reduceMotion) {
        motes.forEach((m) => {
          const v = (m.v + t / (9000 / m.s)) % 1;
          const u = (m.u + Math.sin(t / 1500 + m.p) * 0.05 + 1) % 1;
          const yy = 64 + v * 84;
          const xx = 39 + (yy - 62) * 0.49 + u * 46;
          R(xx, yy, 1, 1, 'rgba(255,245,210,0.55)');
        });
      }
      // Resplandor del monitor
      const glow = S.night ? 0.045 : 0.012;
      [34, 26, 18].forEach((r) => disc(248, 50, r, `rgba(70,110,255,${glow})`));
      if (S.night && me.mode === 'sit') R(me.x - 6, me.y - 32, 12, 12, 'rgba(70,120,255,0.08)');
      // Lámpara
      if (S.lamp) {
        R(277, 38, 11, 1, 'rgba(255,240,190,0.9)');
        const a = S.night ? 0.07 : 0.025;
        ellipse(276, 64, 22, 10, `rgba(255,205,130,${a})`);
        ellipse(276, 64, 14, 6, `rgba(255,205,130,${a})`);
        if (S.night) [48, 34, 22].forEach((r) => disc(276, 66, r, 'rgba(255,190,120,0.03)'));
      }
      ctx.restore();

      // Neón
      const flick = !reduceMotion && Math.sin(t / 97) > 0.985;
      if (!flick) {
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        const a = S.night ? 0.28 : 0.14;
        [[-1, 0], [1, 0], [0, -1], [0, 1]].forEach(([dx, dy]) => text('</>', 322 + dx, 10 + dy, `rgba(90,130,255,${a})`, 2));
        ctx.restore();
        text('</>', 322, 10, '#8fa6ff', 2);
      }

      // Teclado RGB
      const hue = reduceMotion ? 225 : Math.floor(t / 15) % 360;
      R(228, 70, 34, 1, `hsla(${hue},85%,62%,0.9)`);

      // LEDs del rack
      [31, 42, 53].forEach((yy, row) => {
        for (let i = 0; i < 4; i++) {
          const on = reduceMotion || (Math.floor(t / (150 + row * 60)) * (5 + row * 2) + i * 13) % 5 !== 0;
          const col = me.anim === 'check' && me.mode === 'act' ? '#6d8bff' : i === 3 ? '#6d8bff' : '#5fe08a';
          R(322 + i * 2, yy + 3, 1, 1, on ? col : '#1c3a28');
        }
      });
      // Cafetera
      R(354, 92, 1, 1, me.anim === 'coffee' && me.mode === 'act' ? '#ff6b6b' : '#5fe08a');

      // Pantalla del teléfono
      const vib = t < S.notifUntil && t > S.notifUntil - 2000 && Math.floor(t / 60) % 2 === 0 ? 1 : 0;
      const px = 206 + vib;
      if (t < S.notifUntil) {
        R(px, 67, 5, 9, '#1a2340');
        R(px, 68, 5, 3, '#25d366');
        R(px + 1, 72, 3, 1, '#e8e8f0');
        R(px + 1, 74, 2, 1, '#8a93b8');
        if (Math.floor(t / 250) % 2 === 0) text('!', px + 1, 58, '#ffd36b');
      } else {
        R(px, 67, 5, 9, '#141a30');
      }

      // Vapor de la taza
      if (!reduceMotion) {
        for (let i = 0; i < 3; i++) {
          const ph = (t / 1000 + i / 3) % 1;
          R(207 + i + Math.round(Math.sin(ph * 6 + i)), 55 - ph * 10, 1, 2, `rgba(235,235,245,${(0.5 * (1 - ph)).toFixed(2)})`);
        }
      }
    };

    // Flecha sobre el objeto enfocado
    const drawPointer = () => {
      let id = S.hover;
      if (!id && !S.interacted && Math.floor(S.t / 5000) % 2 === 0) id = 'monitor';
      if (!id || id === 'me') return;
      const hs = hotspotRects[id];
      if (!hs) return;
      const bob = reduceMotion ? 0 : Math.round(Math.sin(S.t / 160) * 1.5);
      const cx = Math.round(hs.x + hs.w / 2);
      const y = Math.max(3, hs.y - 7 + bob);
      R(cx - 4, y - 1, 9, 1, P.ink);
      R(cx - 3, y, 7, 1, P.ink);
      R(cx - 3, y - 1, 7, 1, '#fff8dc');
      R(cx - 2, y, 5, 1, '#fff8dc');
      R(cx - 1, y + 1, 3, 1, '#fff8dc');
      R(cx, y + 2, 1, 1, '#fff8dc');
      R(cx - 2, y + 1, 1, 1, P.ink);
      R(cx + 2, y + 1, 1, 1, P.ink);
      R(cx - 1, y + 2, 1, 1, P.ink);
      R(cx + 1, y + 2, 1, 1, P.ink);
      R(cx, y + 3, 1, 1, P.ink);
    };

    // Viñeta suave en las esquinas
    const drawVignette = () => {
      const a = 0.05 + S.dark * 0.12;
      for (let i = 0; i < 4; i++) {
        const d = 10 + i * 10;
        R(0, 0, W, 2 + i * 2, `rgba(5,6,18,${a})`);
        R(0, H - 2 - i * 2, W, 2 + i * 2, `rgba(5,6,18,${a})`);
        R(0, 0, d / 5 + i * 2, H, `rgba(5,6,18,${a})`);
        R(W - d / 5 - i * 2, 0, d / 5 + i * 2, H, `rgba(5,6,18,${a})`);
      }
    };

    const draw = () => {
      ctx.imageSmoothingEnabled = false;
      ctx.clearRect(0, 0, W, H);
      drawShell();
      drawWallDecor();
      drawFurniture();
      const sitting = me.mode === 'sit';
      if (!sitting) drawChairBack();
      // Orden por profundidad (y) entre personaje y gato
      if (cat.y <= me.y) {
        drawCat();
        drawMe();
      } else {
        drawMe();
        drawCat();
      }
      if (S.dark > 0.005) R(0, 0, W, H, `rgba(8,10,32,${S.dark.toFixed(3)})`);
      drawLights();
      drawVignette();
      drawPointer();
    };

    // ---------- Resolución nítida ----------
    let scale = 1;
    const resize = () => {
      const cssW = canvas.clientWidth || W;
      const k = Math.max(1, Math.ceil((cssW * (window.devicePixelRatio || 1)) / W));
      if (k !== scale || canvas.width !== W * k) {
        scale = k;
        canvas.width = W * k;
        canvas.height = H * k;
      }
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      ctx.imageSmoothingEnabled = false;
      draw();
    };
    new ResizeObserver(resize).observe(canvas);

    // ---------- Hotspots ----------
    const hotspotRects: Record<string, { x: number; y: number; w: number; h: number }> = {};
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.hotspot'));
    const btnById: Record<string, HTMLButtonElement> = {};
    buttons.forEach((b) => {
      const id = b.dataset.hotspot!;
      btnById[id] = b;
      hotspotRects[id] = { x: +b.dataset.x!, y: +b.dataset.y!, w: +b.dataset.w!, h: +b.dataset.h! };
      const enter = () => {
        S.hover = id;
      };
      const leave = () => {
        if (S.hover === id) S.hover = null;
      };
      b.addEventListener('pointerenter', enter);
      b.addEventListener('pointerleave', leave);
      b.addEventListener('focus', enter);
      b.addEventListener('blur', leave);
      b.addEventListener('click', () => {
        S.interacted = true;
        S.holdUntil = S.t + 12000;
        lastTrigger = b;
        handle(id);
      });
    });
    const lastPlaced: Record<string, string> = {};
    function placeBtn(id: string, x: number, y: number, w: number, h: number) {
      const b = btnById[id];
      if (!b) return;
      hotspotRects[id] = { x, y, w, h };
      const css = `left:${((x / W) * 100).toFixed(2)}%;top:${((y / H) * 100).toFixed(2)}%;width:${((w / W) * 100).toFixed(2)}%;height:${((h / H) * 100).toFixed(2)}%`;
      if (lastPlaced[id] !== css) {
        b.style.cssText = css;
        lastPlaced[id] = css;
      }
    }
    const syncToggles = () => {
      btnById.window?.setAttribute('aria-pressed', String(S.night));
      btnById.lamp?.setAttribute('aria-pressed', String(S.lamp));
    };
    syncToggles();

    const status = root.querySelector<HTMLElement>('.room-status')!;
    let statusTimer = 0;
    const announce = (msg: string) => {
      status.textContent = msg;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => (status.textContent = ''), 3200);
    };

    const handle = (id: string) => {
      switch (id) {
        case 'window':
          S.night = !S.night;
          if (S.night) S.lamp = true;
          syncToggles();
          announce(S.night ? C.nightOn : C.dayOn);
          goTo('window');
          break;
        case 'lamp':
          S.lamp = !S.lamp;
          syncToggles();
          announce(S.lamp ? C.lampOn : C.lampOff);
          break;
        case 'cat':
          cat.meowUntil = S.t + 2200;
          announce(C.catMsg);
          goTo('cat');
          break;
        case 'plant':
          S.plantUntil = S.t + 900;
          announce(C.plantMsg);
          goTo('plant');
          break;
        case 'coffee':
          goTo('coffee');
          openDialog('coffee');
          break;
        case 'phone':
          S.notifUntil = 0;
          goTo('desk');
          openDialog('phone');
          break;
        case 'monitor':
        case 'neon':
          goTo('desk');
          openDialog(id);
          break;
        case 'bookshelf':
        case 'poster':
        case 'homelab':
          goTo(id);
          openDialog(id);
          break;
        case 'me':
          S.waveUntil = S.t + 2500;
          openDialog('me');
          break;
      }
    };

    // ---------- Diálogo estilo RPG ----------
    const dialog = root.querySelector<HTMLElement>('.room-dialog')!;
    const dEyebrow = dialog.querySelector<HTMLElement>('.room-dialog-eyebrow')!;
    const dTitle = dialog.querySelector<HTMLElement>('.room-dialog-title')!;
    const dBody = dialog.querySelector<HTMLElement>('.room-dialog-body')!;
    const dActions = dialog.querySelector<HTMLElement>('.room-dialog-actions')!;
    const dClose = dialog.querySelector<HTMLButtonElement>('.room-dialog-close')!;
    let currentId: string | null = null;
    let lastTrigger: HTMLButtonElement | null = null;
    let typeTimer = 0;

    const content = (id: string): { eyebrow: string; title: string; body: string; actions: Action[] } => {
      const L = data.links;
      switch (id) {
        case 'monitor': {
          const p = data.projects[S.proj];
          return {
            eyebrow: `${C.workingOn} · ${p.tag}`,
            title: p.name,
            body: p.summary,
            actions: [
              { label: C.viewCase, href: p.href },
              { label: C.next, run: () => { setProject(S.proj + 1); openDialog('monitor', false); } },
            ],
          };
        }
        case 'neon':
          return { eyebrow: '</>', title: C.projectsTitle, body: C.projectsBody, actions: [{ label: C.projectsCta, href: L.projects }] };
        case 'bookshelf':
          return { eyebrow: 'README.md', title: C.aboutTitle, body: C.aboutBody, actions: [{ label: C.aboutCta, href: L.about }] };
        case 'poster':
          return { eyebrow: 'git log', title: C.expTitle, body: C.expBody, actions: [{ label: C.expCta, href: L.experience }] };
        case 'homelab':
          return { eyebrow: 'docker ps', title: C.srvTitle, body: C.srvBody, actions: [{ label: C.srvCta, href: L.services }] };
        case 'phone':
          return { eyebrow: '● online', title: C.phoneTitle, body: C.phoneBody, actions: [{ label: C.phoneCta, href: L.contact }] };
        case 'coffee':
          return { eyebrow: '☕', title: C.mugTitle, body: C.mugBody.replace('{n}', String(S.cups + 1)), actions: [{ label: C.mugCta, href: L.contact }] };
        case 'me':
        default:
          return {
            eyebrow: 'Rogelio López',
            title: C.meTitle,
            body: C.meBody,
            actions: [
              { label: C.meCta1, href: L.contact },
              { label: C.meCta2, href: L.projects },
            ],
          };
      }
    };

    function openDialog(id: string, focus = true) {
      const c = content(id);
      currentId = id;
      dEyebrow.textContent = c.eyebrow;
      dTitle.textContent = c.title;
      dActions.replaceChildren(
        ...c.actions.map((a, i) => {
          const el = document.createElement(a.href ? 'a' : 'button') as HTMLAnchorElement | HTMLButtonElement;
          el.className = `room-action${i === 0 ? ' is-primary' : ''}`;
          el.textContent = a.label;
          if (a.href) {
            (el as HTMLAnchorElement).href = a.href;
            if (a.href.includes('#')) el.addEventListener('click', () => closeDialog(false));
          } else {
            (el as HTMLButtonElement).type = 'button';
            el.addEventListener('click', () => a.run?.());
          }
          return el;
        })
      );
      dialog.hidden = false;
      window.clearInterval(typeTimer);
      if (reduceMotion) {
        dBody.textContent = c.body;
      } else {
        let n = 0;
        dBody.textContent = '';
        typeTimer = window.setInterval(() => {
          n += 2;
          dBody.textContent = c.body.slice(0, n);
          if (n >= c.body.length) window.clearInterval(typeTimer);
        }, 16);
      }
      if (focus) (dActions.firstElementChild as HTMLElement | null)?.focus({ preventScroll: true });
    }

    const closeDialog = (restore = true) => {
      window.clearInterval(typeTimer);
      dialog.hidden = true;
      currentId = null;
      if (restore) lastTrigger?.focus({ preventScroll: true });
    };
    dClose.addEventListener('click', () => closeDialog());
    dBody.addEventListener('click', () => {
      if (!currentId) return;
      window.clearInterval(typeTimer);
      dBody.textContent = content(currentId).body;
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dialog.hidden) closeDialog();
    });

    // ---------- Bucle ----------
    let raf = 0;
    let last = performance.now();
    let acc = 0;
    let visible = true;
    // Con movimiento reducido se dibuja a 4 fps y sin desplazamientos.
    const FRAME = reduceMotion ? 250 : 1000 / 30;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = Math.min(100, now - last);
      last = now;
      acc += dt;
      if (acc < FRAME) return;
      update(acc);
      acc = 0;
      draw();
    };
    const start = () => {
      if (raf) return;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      visible && !document.hidden ? start() : stop();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden || !visible ? stop() : start()));

    update(0);
    resize();
    start();
  }
</script>

