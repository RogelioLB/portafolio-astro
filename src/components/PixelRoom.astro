      // Resplandor del monitor (discos escalonados = luz "pixel")
      const glow = S.night ? 0.045 : 0.012;
      [34, 26, 18].forEach((r) => disc(242, 76, r, `rgba(70,110,255,${glow})`));
      if (S.night) R(187, 64, 14, 15, 'rgba(70,120,255,0.10)');
      // Lámpara
      if (S.lamp) {
        R(289, 74, 11, 1, 'rgba(255,240,190,0.9)');
        ctx.fillStyle = `rgba(255,205,130,${S.night ? 0.13 : 0.05})`;
        ctx.beginPath();
        ctx.moveTo(289, 74);
        ctx.lineTo(300, 74);
        ctx.lineTo(304, 104);
        ctx.lineTo(258, 104);
        ctx.closePath();
        ctx.fill();
        R(254, 103, 56, 2, `rgba(255,205,130,${S.night ? 0.18 : 0.06})`);
        if (S.night) [40, 30, 20].forEach((r) => disc(292, 92, r, 'rgba(255,190,120,0.035)'));
      }
      // Sol en el piso (día)
      if (!S.night) {
        ctx.fillStyle = 'rgba(255,236,190,0.09)';
        ctx.beginPath();
        ctx.moveTo(34, 135);
        ctx.lineTo(90, 135);
        ctx.lineTo(126, 170);
        ctx.lineTo(62, 170);
        ctx.closePath();
        ctx.fill();
      }
      ctx.restore();

      // Neón
      const flick = !reduceMotion && Math.sin(t / 97) > 0.985;
      if (!flick) {
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        const a = S.night ? 0.28 : 0.14;
        [[-1, 0], [1, 0], [0, -1], [0, 1]].forEach(([dx, dy]) => text('</>', 284 + dx, 25 + dy, `rgba(90,130,255,${a})`, 2));
        ctx.restore();
        text('</>', 284, 25, '#8fa6ff', 2);
      }

      // Teclado RGB
      const hue = reduceMotion ? 225 : Math.floor(t / 15) % 360;
      R(208, 104, 26, 1, `hsla(${hue},85%,62%,0.9)`);

      // LEDs homelab
      for (let i = 0; i < 4; i++) {
        const on1 = reduceMotion || (Math.floor(t / 170) * 7 + i * 13) % 5 !== 0;
        const on2 = reduceMotion || (Math.floor(t / 230) * 5 + i * 11) % 4 !== 0;
        R(277 + i * 2, 120, 1, 1, on1 ? '#5fe08a' : '#1c3a28');
        R(277 + i * 2, 133, 1, 1, on2 ? (i === 3 ? '#6d8bff' : '#5fe08a') : '#1c2a3a');
      }

      // Pantalla del teléfono
      const vib = t < S.notifUntil && t > S.notifUntil - 2000 && Math.floor(t / 60) % 2 === 0 ? 1 : 0;
      const px = 281 + vib;
      if (t < S.notifUntil) {
        R(px, 88, 5, 11, '#1a2340');
        R(px, 90, 5, 3, '#25d366');
        R(px + 1, 94, 3, 1, '#e8e8f0');
        R(px + 1, 96, 2, 1, '#8a93b8');
        if (Math.floor(t / 250) % 2 === 0) text('!', px + 1, 80, '#ffd36b');
      } else {
        R(px, 88, 5, 11, '#141a30');
        R(px + 1, 90, 3, 1, '#2a3360');
      }

      // Vapor del café
      if (!reduceMotion) {
        const burst = t < S.steamUntil;
        const n = burst ? 6 : 3;
        for (let i = 0; i < n; i++) {
          const ph = (t / (burst ? 500 : 1000) + i / n) % 1;
          const y = 93 - ph * (burst ? 16 : 11);
          const x = 265 + (i % 3) * 2 + Math.round(Math.sin(ph * 6 + i));
          R(x, y, 1, 2, `rgba(235,235,245,${(0.55 * (1 - ph)).toFixed(2)})`);
        }
      }
    };

    // Flecha sobre el objeto enfocado
    const drawPointer = () => {
      let id = S.hover;
      if (!id && !S.interacted && Math.floor(S.t / 5000) % 2 === 0) id = 'monitor';
      if (!id) return;
      const hs = hotspotRects[id];
      if (!hs) return;
      const bob = reduceMotion ? 0 : Math.round(Math.sin(S.t / 160) * 1.5);
      const cx = Math.round(hs.x + hs.w / 2);
      let y = hs.y - 8 + bob;
      if (id === 'me') return;
      if (id === 'window' || id === 'neon' || id === 'poster') y = Math.max(2, hs.y - 9 + bob);
      R(cx - 3, y, 7, 1, P.ink);
      R(cx - 4, y - 1, 9, 1, P.ink);
      R(cx - 3, y - 1, 7, 1, '#fff8dc');
      R(cx - 2, y, 5, 1, '#fff8dc');
      R(cx - 1, y + 1, 3, 1, '#fff8dc');
      R(cx, y + 2, 1, 1, '#fff8dc');
      R(cx - 2, y + 1, 1, 1, P.ink);
      R(cx + 2, y + 1, 1, 1, P.ink);
      R(cx - 1, y + 2, 1, 1, P.ink);
      R(cx + 1, y + 2, 1, 1, P.ink);
      R(cx, y + 3, 1, 1, P.ink);
    };

    const draw = () => {
      ctx.imageSmoothingEnabled = false;
      ctx.clearRect(0, 0, W, H);
      drawRoom();
      if (S.dark > 0.005) R(0, 0, W, H, `rgba(8,10,32,${S.dark.toFixed(3)})`);
      drawEmissive();
      drawPointer();
    };

    // ---------- Resolución nítida ----------
    let scale = 1;
    const resize = () => {
      const cssW = canvas.clientWidth || W;
      const k = Math.max(1, Math.ceil((cssW * (window.devicePixelRatio || 1)) / W));
      if (k !== scale || canvas.width !== W * k) {
        scale = k;
        canvas.width = W * k;
        canvas.height = H * k;
      }
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      ctx.imageSmoothingEnabled = false;
      draw();
    };
    new ResizeObserver(resize).observe(canvas);

    // ---------- Hotspots ----------
    const hotspotRects: Record<string, { x: number; y: number; w: number; h: number }> = {};
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.hotspot'));
    buttons.forEach((b) => {
      const id = b.dataset.hotspot!;
      hotspotRects[id] = { x: +b.dataset.x!, y: +b.dataset.y!, w: +b.dataset.w!, h: +b.dataset.h! };
      const enter = () => {
        S.hover = id;
        if (reduceMotion) draw();
      };
      const leave = () => {
        if (S.hover === id) S.hover = null;
        if (reduceMotion) draw();
      };
      b.addEventListener('pointerenter', enter);
      b.addEventListener('pointerleave', leave);
      b.addEventListener('focus', enter);
      b.addEventListener('blur', leave);
      b.addEventListener('click', () => {
        S.interacted = true;
        lastTrigger = b;
        handle(id, b);
        if (reduceMotion) draw();
      });
    });
    const btn = (id: string) => buttons.find((b) => b.dataset.hotspot === id);
    const syncToggles = () => {
      btn('window')?.setAttribute('aria-pressed', String(S.night));
      btn('lamp')?.setAttribute('aria-pressed', String(S.lamp));
    };
    syncToggles();

    const status = root.querySelector<HTMLElement>('.room-status')!;
    let statusTimer = 0;
    const say = (msg: string) => {
      status.textContent = msg;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => (status.textContent = ''), 3200);
    };

    const handle = (id: string, b: HTMLButtonElement) => {
      switch (id) {
        case 'window':
          S.night = !S.night;
          if (S.night) S.lamp = true;
          syncToggles();
          say(S.night ? C.nightOn : C.dayOn);
          break;
        case 'lamp':
          S.lamp = !S.lamp;
          syncToggles();
          say(S.lamp ? C.lampOn : C.lampOff);
          break;
        case 'cat':
          S.catUntil = S.t + 2600;
          say(C.catMsg);
          break;
        case 'plant':
          S.plantUntil = S.t + 900;
          say(C.plantMsg);
          break;
        case 'mug':
          S.cups++;
          S.steamUntil = S.t + 1600;
          openDialog('mug');
          break;
        case 'phone':
          S.notifUntil = 0;
          openDialog('phone');
          break;
        case 'me':
          S.waveUntil = S.t + 2500;
          openDialog('me');
          break;
        default:
          openDialog(id);
      }
    };

    // ---------- Diálogo estilo RPG ----------
    const dialog = root.querySelector<HTMLElement>('.room-dialog')!;
    const dEyebrow = dialog.querySelector<HTMLElement>('.room-dialog-eyebrow')!;
    const dTitle = dialog.querySelector<HTMLElement>('.room-dialog-title')!;
    const dBody = dialog.querySelector<HTMLElement>('.room-dialog-body')!;
    const dActions = dialog.querySelector<HTMLElement>('.room-dialog-actions')!;
    const dClose = dialog.querySelector<HTMLButtonElement>('.room-dialog-close')!;
    let currentId: string | null = null;
    let lastTrigger: HTMLButtonElement | null = null;
    let typeTimer = 0;

    const content = (id: string): { eyebrow: string; title: string; body: string; actions: Action[] } => {
      const L = data.links;
      switch (id) {
        case 'monitor': {
          const p = data.projects[S.proj];
          return {
            eyebrow: `${C.workingOn} · ${p.tag}`,
            title: p.name,
            body: p.summary,
            actions: [
              { label: C.viewCase, href: p.href },
              { label: C.next, run: () => { setProject(S.proj + 1); openDialog('monitor', false); } },
            ],
          };
        }
        case 'neon':
          return { eyebrow: '</>', title: C.projectsTitle, body: C.projectsBody, actions: [{ label: C.projectsCta, href: L.projects }] };
        case 'bookshelf':
          return { eyebrow: 'README.md', title: C.aboutTitle, body: C.aboutBody, actions: [{ label: C.aboutCta, href: L.about }] };
        case 'poster':
          return { eyebrow: 'git log', title: C.expTitle, body: C.expBody, actions: [{ label: C.expCta, href: L.experience }] };
        case 'homelab':
          return { eyebrow: 'docker ps', title: C.srvTitle, body: C.srvBody, actions: [{ label: C.srvCta, href: L.services }] };
        case 'phone':
          return { eyebrow: '● online', title: C.phoneTitle, body: C.phoneBody, actions: [{ label: C.phoneCta, href: L.contact }] };
        case 'mug':
          return { eyebrow: '☕', title: C.mugTitle, body: C.mugBody.replace('{n}', String(S.cups)), actions: [{ label: C.mugCta, href: L.contact }] };
        case 'me':
        default:
          return {
            eyebrow: 'Rogelio López',
            title: C.meTitle,
            body: C.meBody,
            actions: [
              { label: C.meCta1, href: L.contact },
              { label: C.meCta2, href: L.projects },
            ],
          };
      }
    };

    const openDialog = (id: string, focus = true) => {
      const c = content(id);
      currentId = id;
      dEyebrow.textContent = c.eyebrow;
      dTitle.textContent = c.title;
      dActions.replaceChildren(
        ...c.actions.map((a, i) => {
          const el = document.createElement(a.href ? 'a' : 'button') as HTMLAnchorElement | HTMLButtonElement;
          el.className = `room-action${i === 0 ? ' is-primary' : ''}`;
          el.textContent = a.label;
          if (a.href) {
            (el as HTMLAnchorElement).href = a.href;
            if (a.href.includes('#')) el.addEventListener('click', () => closeDialog(false));
          } else {
            (el as HTMLButtonElement).type = 'button';
            el.addEventListener('click', () => a.run?.());
          }
          return el;
        })
      );
      dialog.hidden = false;
      window.clearInterval(typeTimer);
      if (reduceMotion) {
        dBody.textContent = c.body;
      } else {
        let n = 0;
        dBody.textContent = '';
        dBody.setAttribute('aria-label', c.body);
        typeTimer = window.setInterval(() => {
          n += 2;
          dBody.textContent = c.body.slice(0, n);
          if (n >= c.body.length) window.clearInterval(typeTimer);
        }, 16);
      }
      if (focus) (dActions.firstElementChild as HTMLElement | null)?.focus({ preventScroll: true });
    };

    const closeDialog = (restore = true) => {
      window.clearInterval(typeTimer);
      dialog.hidden = true;
      currentId = null;
      if (restore) lastTrigger?.focus({ preventScroll: true });
    };
    dClose.addEventListener('click', () => closeDialog());
    dBody.addEventListener('click', () => {
      if (!currentId) return;
      window.clearInterval(typeTimer);
      dBody.textContent = content(currentId).body;
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dialog.hidden) closeDialog();
    });

    // ---------- Bucle ----------
    let raf = 0;
    let last = performance.now();
    let acc = 0;
    let visible = true;
    // Con movimiento reducido se dibuja a 4 fps y sin animaciones de personaje.
    const FRAME = reduceMotion ? 250 : 1000 / 20;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = Math.min(100, now - last);
      last = now;
      acc += dt;
      if (acc < FRAME) return;
      update(acc);
      acc = 0;
      draw();
    };
    const start = () => {
      if (raf) return;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      visible && !document.hidden ? start() : stop();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden || !visible ? stop() : start()));

    resize();
    start();
  }
</script>

<style>
  .room {
    width: 100%;
  }

  .room-stage {
    position: relative;
  }

  .room-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #1b1d3a;
    border: 1px solid var(--color-rule-2);
    box-shadow: 0 1px 2px oklch(24% 0.02 258 / 0.06), 0 12px 32px -18px oklch(30% 0.08 258 / 0.45);
  }

  .room-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }

  .room-hotspots {
    position: absolute;
    inset: 0;
  }

  .hotspot {
    position: absolute;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: 2px;
    -webkit-tap-highlight-color: transparent;
  }

  .hotspot:focus-visible {
    outline: 2px dashed #fff8dc;
    outline-offset: 1px;
  }

  .hotspot-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    transform: translate(-50%, 4px);
    padding: 3px 7px 4px;
    font-family: 'Silkscreen', var(--font-mono);
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    color: #f4f1e8;
    background: #141733;
    box-shadow: 0 0 0 2px #0b0d20, 0 0 0 3px #6d8bff;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
    z-index: 2;
  }

  /* Objetos cerca del borde superior: el tooltip va abajo */
  .hotspot[data-hotspot='window'] .hotspot-tip,
  .hotspot[data-hotspot='poster'] .hotspot-tip,
  .hotspot[data-hotspot='neon'] .hotspot-tip,
  .hotspot[data-hotspot='me'] .hotspot-tip {
    bottom: auto;
    top: calc(100% + 6px);
  }
  .hotspot[data-hotspot='neon'] .hotspot-tip,
  .hotspot[data-hotspot='lamp'] .hotspot-tip,
  .hotspot[data-hotspot='homelab'] .hotspot-tip {
    left: auto;
    right: 0;
    transform: translate(0, 4px);
  }
  .hotspot[data-hotspot='plant'] .hotspot-tip {
    left: 0;
    transform: translate(0, 4px);
  }

  .hotspot:hover .hotspot-tip,
  .hotspot:focus-visible .hotspot-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .hotspot[data-hotspot='neon']:hover .hotspot-tip,
  .hotspot[data-hotspot='lamp']:hover .hotspot-tip,
  .hotspot[data-hotspot='homelab']:hover .hotspot-tip,
  .hotspot[data-hotspot='plant']:hover .hotspot-tip,
  .hotspot[data-hotspot='neon']:focus-visible .hotspot-tip,
  .hotspot[data-hotspot='lamp']:focus-visible .hotspot-tip,
  .hotspot[data-hotspot='homelab']:focus-visible .hotspot-tip,
  .hotspot[data-hotspot='plant']:focus-visible .hotspot-tip {
    transform: translate(0, 0);
  }

  /* Diálogo tipo RPG */
  .room-dialog {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 5;
    padding: 12px 14px 12px;
    color: #e8ecff;
    background: #141733;
    box-shadow:
      0 0 0 2px #0b0d20,
      0 0 0 4px #e8e3d6,
      0 0 0 6px #0b0d20,
      0 10px 24px -8px rgb(0 0 0 / 0.5);
    animation: dlg-in 220ms var(--ease-out);
  }

  .room-dialog[hidden] {
    display: none;
  }

  @keyframes dlg-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .room-dialog-close {
    position: absolute;
    top: 6px;
    right: 8px;
    width: 26px;
    height: 26px;
    font-family: 'Silkscreen', var(--font-mono);
    font-size: 16px;
    line-height: 1;
    color: #aab4e8;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .room-dialog-close:hover {
    color: #fff;
  }

  .room-dialog-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #8fa6ff;
    margin-bottom: 2px;
    padding-right: 28px;
  }

  .room-dialog-title {
    font-family: 'Silkscreen', var(--font-display);
    font-size: 17px;
    line-height: 1.2;
    color: #fff8dc;
    margin-bottom: 4px;
    padding-right: 28px;
  }

  .room-dialog-body {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: #cfd6f5;
    min-height: 3.1em;
    max-width: 68ch;
    cursor: default;
  }

  .room-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .room-dialog-actions :global(.room-action) {
    font-family: 'Silkscreen', var(--font-mono);
    font-size: 12px;
    line-height: 1;
    padding: 7px 10px 8px;
    color: #e8ecff;
    background: #232850;
    border: 0;
    box-shadow: 0 0 0 2px #0b0d20, inset 0 -2px 0 #171a3a;
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out), transform 80ms;
  }

  .room-dialog-actions :global(.room-action.is-primary) {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    box-shadow: 0 0 0 2px #0b0d20, inset 0 -2px 0 oklch(45% 0.2 256);
  }

  .room-dialog-actions :global(.room-action:hover) {
    background: #2f3668;
  }

  .room-dialog-actions :global(.room-action.is-primary:hover) {
    background: oklch(52% 0.2 256);
  }

  .room-dialog-actions :global(.room-action:active) {
    transform: translateY(1px);
  }

  .room-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    min-height: 1.2rem;
  }

  .room-hint,
  .room-status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .room-hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .room-hint-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    animation: hint-blink 1.2s steps(2, jump-none) infinite;
  }

  .room-status {
    text-align: right;
    color: var(--color-accent);
  }

  @keyframes hint-blink {
    0% { opacity: 1; }
    100% { opacity: 0.2; }
  }

  /* En pantallas angostas el diálogo va debajo de la escena para no taparla. */
  @media (max-width: 40rem) {
    .room-screen {
      border-radius: var(--radius-control);
    }
    .room-dialog {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      margin: 18px 6px 6px;
    }
    .hotspot-tip {
      display: none;
    }
    .room-dialog-title {
      font-size: 15px;
    }
    .room-dialog-body {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-dialog { animation: none; }
    .room-hint-dot { animation: none; }
  }
</style>
