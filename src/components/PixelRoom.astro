  .room-hint-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    animation: hint-blink 1.2s steps(2, jump-none) infinite;
  }

  .room-status {
    text-align: right;
    color: var(--color-accent);
  }

  @keyframes hint-blink {
    0% { opacity: 1; }
    100% { opacity: 0.2; }
  }

  /* En pantallas angostas el diálogo va debajo de la escena para no taparla. */
  @media (max-width: 40rem) {
    .room-screen {
      border-radius: var(--radius-control);
    }
    .room-dialog {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      margin: 18px 6px 6px;
    }
    .hotspot-tip {
      display: none;
    }
    .room-dialog-title {
      font-size: 15px;
    }
    .room-dialog-body {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-dialog { animation: none; }
    .room-hint-dot { animation: none; }
  }
</style>
