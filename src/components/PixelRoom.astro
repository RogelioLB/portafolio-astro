---
// PixelRoom.astro — Escena pixel art 2D interactiva: Rogelio programando en su cuarto.
// Todo se dibuja por código en un <canvas> de 320×180 (sin sprites externos) y se escala
// con image-rendering: pixelated. Los objetos clicables son <button> reales superpuestos,
// así la escena es accesible con teclado y lectores de pantalla.
import { projects } from '../data/projects';
import { projectPath, homePath, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const home = homePath(lang);

const copy = {
  es: {
    sr: 'Ilustración pixel art animada: Rogelio programando en la computadora de su cuarto. Los objetos del cuarto son botones que llevan a distintas secciones del portafolio.',
    hint: 'Haz clic en los objetos del cuarto',
    close: 'Cerrar',
    workingOn: 'Trabajando en…',
    viewCase: 'Ver caso completo →',
    next: 'Siguiente ▶',
    nightOn: 'Modo noche',
    dayOn: 'Modo día',
    lampOn: 'Lámpara encendida',
    lampOff: 'Lámpara apagada',
    catSays: 'MIAU',
    hello: 'HOLA!',
    projectsTitle: 'Proyectos',
    projectsBody: `${projects.length} proyectos reales: plataformas SaaS, librerías open source, una app móvil con IA y una migración de e-commerce.`,
    projectsCta: 'Ver proyectos ↓',
    aboutTitle: 'Sobre mí',
    aboutBody: 'Estudié Ingeniería en Software en la Universidad Autónoma de Occidente y llevo más de 4 años programando: front-end, back-end, DevOps e integraciones.',
    aboutCta: 'Leer más ↓',
    expTitle: 'Experiencia',
    expBody: 'Freelance full-stack para clientes en México y Chile desde 2023; antes, desarrollo en TORKE (2022 – 2025). Mi regla: si no llega a producción, no cuenta.',
    expCta: 'Ver trayectoria ↓',
    srvTitle: 'Servicios',
    srvBody: 'Aquí viven mis contenedores: Linux, Docker y despliegues en VPS. Llevo tu proyecto desde la idea hasta producción.',
    srvCta: 'Ver servicios ↓',
    phoneTitle: '1 mensaje nuevo',
    phoneBody: '¿Tienes un proyecto en mente? Estoy disponible para empleo, freelance o consultoría. Escríbeme y te respondo pronto.',
    phoneCta: 'Contáctame →',
    mugTitle: 'Café',
    mugBody: 'Combustible oficial de cada deploy. Tazas de hoy: {n}.',
    mugCta: '¿Un café virtual? Hablemos →',
    meTitle: '¡Hola! Soy Rogelio',
    meBody: 'Ingeniero de software full-stack en Sinaloa, México. Explora mi cuarto: cada objeto te lleva a una parte de mi trabajo.',
    meCta1: 'Contáctame',
    meCta2: 'Ver proyectos',
    plantMsg: 'La planta se sacude. Se riega con cada commit.',
    catMsg: 'El gato despertó… y se volvió a dormir.',
  },
  en: {
    sr: 'Animated pixel art illustration: Rogelio coding at the computer in his room. Objects in the room are buttons that lead to different sections of the portfolio.',
    hint: 'Click objects in the room',
    close: 'Close',
    workingOn: 'Working on…',
    viewCase: 'Read the full case →',
    next: 'Next ▶',
    nightOn: 'Night mode',
    dayOn: 'Day mode',
    lampOn: 'Lamp on',
    lampOff: 'Lamp off',
    catSays: 'MEOW',
    hello: 'HI!',
    projectsTitle: 'Projects',
    projectsBody: `${projects.length} real projects: SaaS platforms, open-source libraries, an AI mobile app, and an e-commerce migration.`,
    projectsCta: 'View projects ↓',
    aboutTitle: 'About me',
    aboutBody: 'I studied Software Engineering at Universidad Autónoma de Occidente and have 4+ years of coding across front-end, back-end, DevOps, and integrations.',
    aboutCta: 'Read more ↓',
    expTitle: 'Experience',
    expBody: 'Freelance full-stack work for clients in Mexico and Chile since 2023; before that, development at TORKE (2022 – 2025). My rule: if it doesn’t reach production, it doesn’t count.',
    expCta: 'See track record ↓',
    srvTitle: 'Services',
    srvBody: 'This is where my containers live: Linux, Docker, and VPS deployments. I take your project from idea to production.',
    srvCta: 'View services ↓',
    phoneTitle: '1 new message',
    phoneBody: 'Have a project in mind? I’m available for full-time roles, freelance, or consulting. Send me a message and I’ll reply soon.',
    phoneCta: 'Contact me →',
    mugTitle: 'Coffee',
    mugBody: 'Official fuel for every deploy. Cups today: {n}.',
    mugCta: 'Virtual coffee? Let’s talk →',
    meTitle: 'Hi! I’m Rogelio',
    meBody: 'Full-stack software engineer based in Sinaloa, Mexico. Explore my room: every object leads to a part of my work.',
    meCta1: 'Contact me',
    meCta2: 'View projects',
    plantMsg: 'The plant wiggles. It gets watered with every commit.',
    catMsg: 'The cat woke up… and went back to sleep.',
  },
}[lang];

const labels = {
  es: {
    me: ['¡Hola!', 'Rogelio: saludar'],
    monitor: ['Monitor', 'Monitor: ver en qué proyecto estoy trabajando'],
    neon: ['Proyectos', 'Letrero de neón: ver todos los proyectos'],
    bookshelf: ['Sobre mí', 'Librero: sobre mí'],
    poster: ['Experiencia', 'Póster: experiencia profesional'],
    homelab: ['Servicios', 'Servidor: servicios'],
    phone: ['Contacto', 'Teléfono: contacto'],
    mug: ['Café', 'Taza de café'],
    lamp: ['Lámpara', 'Lámpara: encender o apagar'],
    window: ['Día / noche', 'Ventana: cambiar entre día y noche'],
    cat: ['Gato', 'Gato dormido: despertarlo'],
    plant: ['Planta', 'Planta'],
  },
  en: {
    me: ['Hi!', 'Rogelio: say hi'],
    monitor: ['Monitor', 'Monitor: see which project I’m working on'],
    neon: ['Projects', 'Neon sign: view all projects'],
    bookshelf: ['About me', 'Bookshelf: about me'],
    poster: ['Experience', 'Poster: professional experience'],
    homelab: ['Services', 'Server: services'],
    phone: ['Contact', 'Phone: contact'],
    mug: ['Coffee', 'Coffee mug'],
    lamp: ['Lamp', 'Lamp: toggle on or off'],
    window: ['Day / night', 'Window: toggle day and night'],
    cat: ['Cat', 'Sleeping cat: wake it up'],
    plant: ['Plant', 'Plant'],
  },
}[lang];

// Zonas clicables en coordenadas nativas del canvas (320×180). El orden importa: los
// últimos quedan encima (el gato está sobre la ventana).
const hotspots: { id: keyof typeof labels; x: number; y: number; w: number; h: number; toggle?: boolean }[] = [
  { id: 'window', x: 30, y: 20, w: 62, h: 44, toggle: true },
  { id: 'cat', x: 32, y: 62, w: 30, h: 20 },
  { id: 'plant', x: 2, y: 84, w: 24, h: 54 },
  { id: 'bookshelf', x: 106, y: 44, w: 44, h: 98 },
  { id: 'poster', x: 154, y: 20, w: 30, h: 40 },
  { id: 'me', x: 164, y: 52, w: 44, h: 88 },
  { id: 'monitor', x: 212, y: 54, w: 60, h: 44 },
  { id: 'neon', x: 278, y: 20, w: 36, h: 22 },
  { id: 'mug', x: 261, y: 89, w: 14, h: 16 },
  { id: 'phone', x: 277, y: 85, w: 12, h: 20 },
  { id: 'lamp', x: 290, y: 62, w: 24, h: 43, toggle: true },
  { id: 'homelab', x: 271, y: 113, w: 34, h: 30 },
];

const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;

const roomData = {
  lang,
  copy,
  links: {
    projects: `${home}#proyectos`,
    about: `${home}#sobre-mi`,
    experience: `${home}#experiencia`,
    services: `${home}#servicios`,
    contact: `${home}#contacto`,
  },
  projects: projects.map((p) => ({
    slug: p.slug,
    name: p.name,
    short: ({ 'nexo-laboral': 'NEXO', palettesnap: 'PALETTE', 'node-yt-converter': 'NODE-YT', alfri: 'ALFRI' } as Record<string, string>)[p.slug] ?? p.name,
    tag: p.tag[lang],
    summary: p.summary[lang],
    href: projectPath(lang, p.slug),
    tech: p.tech,
  })),
};
---

<div class="room" data-room>
  <p class="sr-only">{copy.sr}</p>
  <div class="room-stage">
    <div class="room-screen">
    <canvas class="room-canvas" width="320" height="180" aria-hidden="true"></canvas>
    <div class="room-hotspots">
      {hotspots.map((h) => (
        <button
          type="button"
          class="hotspot"
          data-hotspot={h.id}
          data-x={h.x}
          data-y={h.y}
          data-w={h.w}
          data-h={h.h}
          aria-label={labels[h.id][1]}
          aria-pressed={h.toggle ? 'false' : undefined}
          style={`left:${pct(h.x, 320)};top:${pct(h.y, 180)};width:${pct(h.w, 320)};height:${pct(h.h, 180)}`}
        >
          <span class="hotspot-tip" aria-hidden="true">{labels[h.id][0]}</span>
        </button>
      ))}
    </div>
    </div>

    <div class="room-dialog" role="dialog" aria-modal="false" aria-labelledby="room-dialog-title" hidden>
      <button type="button" class="room-dialog-close" aria-label={copy.close}>×</button>
      <span class="room-dialog-eyebrow"></span>
      <p class="room-dialog-title" id="room-dialog-title"></p>
      <p class="room-dialog-body"></p>
      <div class="room-dialog-actions"></div>
    </div>
  </div>

  <div class="room-footer">
    <span class="room-hint"><span class="room-hint-dot" aria-hidden="true"></span>{copy.hint}</span>
    <span class="room-status" aria-live="polite"></span>
  </div>
</div>

<script type="application/json" id="room-data" is:inline set:html={JSON.stringify(roomData)} />

<script>
  type Proj = { slug: string; name: string; short: string; tag: string; summary: string; href: string; tech: string[] };
  type RoomData = {
    lang: string;
    copy: Record<string, string>;
    links: Record<'projects' | 'about' | 'experience' | 'services' | 'contact', string>;
    projects: Proj[];
  };
  type Action = { label: string; href?: string; run?: () => void };

  const root = document.querySelector<HTMLElement>('[data-room]');
  const dataEl = document.getElementById('room-data');
  if (root && dataEl) initRoom(root, JSON.parse(dataEl.textContent || '{}') as RoomData);

  function initRoom(root: HTMLElement, data: RoomData) {
    const W = 320;
    const H = 180;
    const canvas = root.querySelector<HTMLCanvasElement>('.room-canvas')!;
    const ctx = canvas.getContext('2d')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const C = data.copy;

    // ---------- Paleta ----------
    const P = {
      wall: '#3b3f6e', wallStripe: '#373a67', wallTop: '#2f325c', base: '#2a2c4f', baseHi: '#4a4f86',
      floor: '#6b4630', floorLine: '#5a3a28', floorHi: '#7d5539',
      wood: '#8a5a3a', woodHi: '#a56f49', woodDk: '#5e3c27', woodDk2: '#4a3020',
      cream: '#e8e3d6', creamDk: '#c9c2b0', ink: '#15172a',
      cobalt: '#4a63d8', cobaltDk: '#3a4fb3', cobaltDk2: '#2a3f8f', cobaltHi: '#6d8bff',
      skin: '#c98b62', skinDk: '#a86c4a', hair: '#1b1a24', hairHi: '#3a3850', mouth: '#8a4f35',
      hood: '#2a2d44', hoodHi: '#383c5a', hoodDk: '#1f2236', armNear: '#343858',
      jeans: '#2e3f6e', jeansDk: '#243259', shoe: '#e8e8f0', sole: '#b8b8c8',
      chair: '#1d1f2e', chairHi: '#2c2f45', metal: '#555a70',
      cat: '#e0893a', catDk: '#b86a2a', catLt: '#f4e6d0',
      leaf1: '#2f7a43', leaf2: '#3f9a55', leaf3: '#5cbf6c', pot: '#b5623b', potHi: '#c9744a', potDk: '#9a4f2e',
    };
    const BOOK_COLORS = ['#c94f4f', '#e0b34a', '#4f8fc9', '#5fb07a', '#9a6bc9', '#e07a4f', '#d8d8d8', '#4a63d8', '#2f8f8a'];
    const CODE_COLORS = ['#9fb4ff', '#c792ea', '#7fd4a0', '#ffcb6b', '#f78c6c', '#89ddff', '#d6d8e8'];

    // ---------- Fuente pixel 3×5 ----------
    const FONT: Record<string, string> = {
      A: '010101111101101', B: '110101110101110', C: '011100100100011', D: '110101101101110', E: '111100110100111',
      F: '111100110100100', G: '011100101101011', H: '101101111101101', I: '111010010010111', J: '001001001101010',
      K: '101101110101101', L: '100100100100111', M: '101111111101101', N: '110101101101101', O: '010101101101010',
      P: '110101110100100', Q: '010101101110011', R: '110101110101101', S: '011100010001110', T: '111010010010010',
      U: '101101101101111', V: '101101101101010', W: '101101111111101', X: '101101010101101', Y: '101101010010010',
      Z: '111001010100111', '0': '111101101101111', '1': '010110010010111', '2': '110001010100111', '3': '110001010001110',
      '4': '101101111001001', '5': '111100110001110', '6': '011100111101111', '7': '111001010010010', '8': '111101111101111',
      '9': '111101111001110', '-': '000000111000000', '.': '000000000000010', ':': '000010000010000', '/': '001001010100100',
      '>': '100010001010100', '<': '001010100010001', '!': '010010010000010', '?': '110001010000010', ' ': '000000000000000',
      '✓': '000001001101010', '_': '000000000000111',
    };
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toUpperCase();
    const textW = (s: string, sc = 1) => Math.max(0, s.length * 4 * sc - sc);

    // ---------- Primitivas ----------
    const R = (x: number, y: number, w: number, h: number, c: string) => {
      ctx.fillStyle = c;
      ctx.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h));
    };
    const text = (s: string, x: number, y: number, c: string, sc = 1) => {
      ctx.fillStyle = c;
      let cx = Math.round(x);
      for (const ch of norm(s)) {
        const g = FONT[ch] ?? FONT['?'];
        for (let i = 0; i < 15; i++) {
          if (g[i] === '1') ctx.fillRect(cx + (i % 3) * sc, Math.round(y) + Math.floor(i / 3) * sc, sc, sc);
        }
        cx += 4 * sc;
      }
    };
    const line = (x0: number, y0: number, x1: number, y1: number, w: number, c: string) => {
      const steps = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0), 1);
      ctx.fillStyle = c;
      const o = Math.floor(w / 2);
      for (let i = 0; i <= steps; i++) {
        const x = Math.round(x0 + ((x1 - x0) * i) / steps) - o;
        const y = Math.round(y0 + ((y1 - y0) * i) / steps) - o;
        ctx.fillRect(x, y, w, w);
      }
    };
    const disc = (cx: number, cy: number, r: number, c: string) => {
      for (let dy = -r; dy <= r; dy++) {
        const half = Math.floor(Math.sqrt(r * r - dy * dy) + 0.35);
        R(cx - half, cy + dy, half * 2 + 1, 1, c);
      }
    };
    const rng = (seed: number) => () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const bubble = (x: number, y: number, w: number, h: number, tailX: number) => {
      R(x + 1, y, w - 2, h, P.ink);
      R(x, y + 1, w, h - 2, P.ink);
      R(x + 1, y + 1, w - 2, h - 2, '#f4f1e8');
      R(tailX, y + h - 1, 3, 1, '#f4f1e8');
      R(tailX + 1, y + h, 2, 1, P.ink);
      R(tailX, y + h, 1, 1, P.ink);
      R(tailX + 1, y + h - 1, 1, 1, '#f4f1e8');
      R(tailX + 2, y + h + 1, 1, 1, P.ink);
    };

    // ---------- Datos precalculados ----------
    const bookR = rng(7);
    const shelves = [
      { top: 49, bottom: 68 },
      { top: 71, bottom: 90 },
      { top: 93, bottom: 112 },
      { top: 115, bottom: 136 },
    ];
    type Book = { x: number; y: number; w: number; h: number; c: string };
    const books: Book[] = [];
    shelves.forEach((s, si) => {
      let x = 112;
      const limit = si === 1 ? 134 : si === 3 ? 136 : 145;
      while (x < limit) {
        const w = 2 + Math.floor(bookR() * 3);
        if (x + w > limit) break;
        const maxH = s.bottom - s.top - 2;
        const h = Math.max(10, maxH - Math.floor(bookR() * 6));
        books.push({ x, y: s.bottom - h, w, h, c: BOOK_COLORS[Math.floor(bookR() * BOOK_COLORS.length)] });
        x += w + (bookR() < 0.12 ? 1 : 0);
      }
    });
    const stars = Array.from({ length: 16 }, (_, i) => {
      const r = rng(100 + i);
      return { x: 33 + Math.floor(r() * 54), y: 25 + Math.floor(r() * 22), p: r() * 6 };
    });
    const skyline = [
      [32, 66, 8], [40, 60, 6], [46, 64, 7], [53, 57, 5], [58, 62, 9], [67, 58, 6], [73, 63, 8], [81, 60, 7],
    ];
    const cityLights = Array.from({ length: 14 }, (_, i) => {
      const r = rng(300 + i);
      const b = skyline[Math.floor(r() * skyline.length)];
      return { x: b[0] + 1 + Math.floor(r() * (b[2] - 2)), y: b[1] + 2 + Math.floor(r() * (74 - b[1] - 3)) };
    });

    type Tok = { w: number; c: string };
    type CodeLine = { indent: number; toks: Tok[] };
    const genCode = (seed: number): CodeLine[] => {
      const r = rng(seed * 97 + 13);
      const lines: CodeLine[] = [];
      let indent = 0;
      for (let i = 0; i < 16; i++) {
        if (indent > 0 && r() < 0.25) indent--;
        const n = r() < 0.12 ? 0 : 1 + Math.floor(r() * 4);
        const toks: Tok[] = [];
        for (let j = 0; j < n; j++) toks.push({ w: 2 + Math.floor(r() * 8), c: CODE_COLORS[Math.floor(r() * CODE_COLORS.length)] });
        lines.push({ indent, toks });
        if (n > 0 && indent < 3 && r() < 0.32) indent++;
      }
      return lines;
    };

    // ---------- Estado ----------
    const hour = new Date().getHours();
    const S = {
      t: 0,
      night: hour < 7 || hour >= 19,
      lamp: true,
      dark: 0,
      proj: 0,
      code: genCode(0),
      totalToks: 0,
      typed: 0,
      phase: 'typing' as 'typing' | 'think' | 'build' | 'deployed',
      phaseT: 0,
      thought: false,
      hover: null as string | null,
      catUntil: 0,
      plantUntil: 0,
      notifUntil: 0,
      nextNotif: 6000,
      nextBlink: 2500,
      blinkUntil: 0,
      steamUntil: 0,
      waveUntil: 0,
      cups: 3,
      interacted: false,
      tick: 0,
    };
    const countToks = () => S.code.reduce((a, l) => a + l.toks.length, 0);
    S.totalToks = countToks();
    S.dark = S.night ? 0.44 : 0;
    if (reduceMotion) S.typed = S.totalToks;

    const setProject = (i: number) => {
      S.proj = (i + data.projects.length) % data.projects.length;
      S.code = genCode(S.proj + 1);
      S.totalToks = countToks();
      S.typed = reduceMotion ? S.totalToks : 0;
      S.phase = 'typing';
      S.phaseT = 0;
      S.thought = false;
    };

    // ---------- Actualización ----------
    const update = (dt: number) => {
      S.t += dt;
      S.phaseT += dt;
      const t = S.t;

      if (reduceMotion) {
        // Escena fija: código completo, sin ciclo de proyectos.
      } else if (S.phase === 'typing') {
        S.typed = Math.min(S.totalToks, S.typed + dt / 85);
        if (!S.thought && S.typed >= S.totalToks * 0.55) {
          S.phase = 'think';
          S.phaseT = 0;
          S.thought = true;
        } else if (S.typed >= S.totalToks) {
          S.phase = 'build';
          S.phaseT = 0;
        }
      } else if (S.phase === 'think' && S.phaseT > 1500) {
        S.phase = 'typing';
        S.phaseT = 0;
      } else if (S.phase === 'build' && S.phaseT > 1700) {
        S.phase = 'deployed';
        S.phaseT = 0;
      } else if (S.phase === 'deployed' && S.phaseT > 2000) {
        setProject(S.proj + 1);
        if (!dialog.hidden && currentId === 'monitor') openDialog('monitor', false);
      }

      if (t > S.nextBlink) {
        S.blinkUntil = t + 140;
        S.nextBlink = t + 2500 + Math.random() * 3000;
      }
      if (t > S.nextNotif) {
        S.notifUntil = t + 2600;
        S.nextNotif = t + 14000 + Math.random() * 6000;
      }
      const target = S.night ? (S.lamp ? 0.44 : 0.64) : S.lamp ? 0.02 : 0.06;
      S.dark += (target - S.dark) * Math.min(1, dt / 180);
    };

    // ---------- Dibujo: cuarto ----------
    const drawRoom = () => {
      const t = S.t;
      // Pared
      R(0, 0, W, 134, P.wall);
      for (let x = 10; x < W; x += 20) R(x, 4, 1, 124, P.wallStripe);
      R(0, 0, W, 4, P.wallTop);
      R(0, 128, W, 6, P.base);
      R(0, 128, W, 1, P.baseHi);
      // Piso
      R(0, 134, W, 46, P.floor);
      R(0, 134, W, 1, P.floorHi);
      for (let row = 0; row < 6; row++) {
        const y = 141 + row * 8;
        R(0, y, W, 1, P.floorLine);
        for (let x = (row * 37) % 48; x < W; x += 48) R(x, y - 7, 1, 7, P.floorLine);
      }
      // Tapete
      R(142, 137, 94, 15, P.cobaltDk);
      R(140, 138, 98, 13, P.cobaltDk);
      R(144, 139, 90, 11, P.cobalt);
      R(146, 141, 86, 1, P.cobaltHi);
      R(146, 147, 86, 1, P.cobaltHi);
      for (let x = 142; x < 236; x += 3) R(x, 152, 1, 2, P.creamDk);

      drawWindow();
      drawCat();
      drawPlant();
      drawBookshelf();
      drawPoster();
      drawClock();
      drawDesk();
      drawChar();
    };

    const drawWindow = () => {
      const t = S.t;
      // Cielo
      if (S.night) {
        R(32, 24, 56, 12, '#1a2150');
        R(32, 36, 56, 14, '#222b62');
        R(32, 50, 56, 26, '#2b3672');
