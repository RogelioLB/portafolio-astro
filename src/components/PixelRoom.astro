      // Monitor: solo avanza mientras Rogelio está sentado programando.
      if (!reduceMotion && me.mode === 'sit') {
        S.phaseT += dt;
        if (S.phase === 'typing') {
          S.typed = Math.min(S.totalToks, S.typed + dt / 85);
          if (!S.thought && S.typed >= S.totalToks * 0.55) {
            S.phase = 'think';
            S.phaseT = 0;
            S.thought = true;
          } else if (S.typed >= S.totalToks) {
            S.phase = 'build';
            S.phaseT = 0;
          }
        } else if (S.phase === 'think' && S.phaseT > 1500) {
          S.phase = 'typing';
          S.phaseT = 0;
        } else if (S.phase === 'build' && S.phaseT > 1700) {
          S.phase = 'deployed';
          S.phaseT = 0;
        } else if (S.phase === 'deployed' && S.phaseT > 2000) {
          setProject(S.proj + 1);
          if (!dialog.hidden && currentId === 'monitor') openDialog('monitor', false);
        }
      }

      if (!reduceMotion) {
        // Personaje
        if (me.mode === 'walk' && step(me, 42, dt)) arrive();
        else if (me.mode === 'act') {
          me.actT += dt;
          if (me.anim === 'read' && me.actT > 900) me.dir = 'down';
          if (me.anim === 'coffee' && me.actT > 2200) me.dir = 'down';
          if (me.actT > me.actDur) goTo('desk');
        }

        // Rutina automática: se levanta de vez en cuando.
        if (t > S.nextRoutine) {
          S.nextRoutine = t + 15000 + Math.random() * 9000;
          if (me.mode === 'sit' && t > S.holdUntil && dialog.hidden && S.phase !== 'deployed') {
            const pool = ['coffee', 'bookshelf', 'cat', 'stretch', 'homelab', 'window', 'plant'];
            goTo(pool[Math.floor(Math.random() * pool.length)]);
          }
        }

        // Gato
        if (cat.mode === 'walk' && step(cat, 30, dt)) {
          cat.mode = cat.after;
          cat.until = t + 9000 + Math.random() * 5000;
          cat.dir = 'down';
        } else if (cat.mode === 'sit' && t > cat.until) {
          cat.mode = 'walk';
          cat.after = 'sleep';
          cat.walkT = 0;
          cat.path = [[Math.round(cat.x), 124], [88, 124], BED_CAT];
        } else if (cat.mode === 'sleep' && t > cat.next && me.mode !== 'walk') {
          cat.next = t + 40000 + Math.random() * 20000;
          const dest: Pt = Math.random() < 0.5 ? [180, 150] : [270, 118];
          cat.mode = 'walk';
          cat.after = 'sit';
          cat.walkT = 0;
          cat.path = [[88, 124], [dest[0], 124], dest];
        }
      }

      if (t > S.nextBlink) {
        S.blinkUntil = t + 140;
        S.nextBlink = t + 2500 + Math.random() * 3000;
      }
      if (t > S.nextNotif) {
        S.notifUntil = t + 2600;
        S.nextNotif = t + 15000 + Math.random() * 6000;
      }
      const target = S.night ? (S.lamp ? 0.46 : 0.64) : S.lamp ? 0.02 : 0.06;
      S.dark += (target - S.dark) * Math.min(1, dt / 180);

