---
// Contact.astro — Contact tile + Ft2 inline single-line footer.
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="contact" id="contacto">
  <div class="section-head">
    <span class="mono-label">{t('contact.eyebrow')}</span>
    <h2>{t('contact.title')}</h2>
  </div>

  <div class="tile contact-tile reveal">
    <div class="contact-info">
      <h3>{t('contact.heading')}</h3>
      <p>{t('contact.body')}</p>

      <div class="contact-methods">
        <a href="https://linkedin.com/in/rogeliolb" target="_blank" rel="noopener noreferrer" class="contact-method">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          <div class="method-details">
            <span class="method-label mono-label">{t('contact.linkedin')}</span>
            <span class="method-value">linkedin.com/in/rogeliolb</span>
          </div>
        </a>

        <div class="contact-method no-link">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div class="method-details">
            <span class="method-label mono-label">{t('contact.location')}</span>
            <span class="method-value">{t('contact.location.value')}</span>
          </div>
        </div>
      </div>
    </div>

    <form class="contact-form" id="contact-form-el">
      <div class="form-group">
        <label for="name">{t('contact.form.name')}</label>
        <input type="text" id="name" name="name" required placeholder={t('contact.form.name.placeholder')} />
      </div>

      <div class="form-group">
        <label for="email">{t('contact.form.email')}</label>
        <input type="email" id="email" name="email" required placeholder="tu@correo.com" />
      </div>

      <div class="form-group">
        <label for="message">{t('contact.form.message')}</label>
        <textarea id="message" name="message" rows="4" required placeholder={t('contact.form.message.placeholder')}></textarea>
      </div>

      <button type="submit" class="btn btn-primary btn-submit" id="btn-send-message" data-label={t('contact.form.submit')} data-label-sending={t('contact.form.sending')}>
        {t('contact.form.submit')}
        <svg class="btn-submit-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>
    </form>
  </div>

  <div
    id="toast-container"
    class="toast-container"
    data-msg-sending={t('contact.toast.sending')}
    data-msg-success={t('contact.toast.success')}
    data-msg-error={t('contact.toast.error')}
    data-msg-network={t('contact.toast.network')}
  ></div>

  <footer class="footer">
    <span class="mono-label">rogeliolb.dev</span>
    <span class="footer-sep">·</span>
    <span>© {new Date().getFullYear()} Rogelio López</span>
    <span class="footer-sep">·</span>
    <span>{t('footer.built')}</span>
  </footer>
</section>

<script>
  function showToast(message: string, type: 'info' | 'success' | 'error' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;

    let iconSvg = '';
    if (type === 'success') {
      iconSvg = `
        <svg class="toast-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      `;
    } else if (type === 'error') {
      iconSvg = `
        <svg class="toast-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      `;
    } else {
      iconSvg = `
        <svg class="toast-icon spinning" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="opacity: 0.25; fill: none;"></circle>
          <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      `;
    }

    toast.innerHTML = `${iconSvg}<span class="toast-message">${message}</span>`;
    container.appendChild(toast);

    setTimeout(() => {
      toast.style.animation = 'toast-fade-out 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards';
      setTimeout(() => toast.remove(), 400);
    }, 4600);
  }

  const form = document.getElementById('contact-form-el') as HTMLFormElement;
  const submitBtn = document.getElementById('btn-send-message') as HTMLButtonElement;

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalBtnContent = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';
      submitBtn.innerHTML = `
        Enviando…
        <svg class="btn-submit-icon spinning" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 16px; height: 16px;">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="opacity: 0.25; fill: none;"></circle>
          <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      `;

      showToast('Enviando tu mensaje a Rogelio…', 'info');

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
      };

      try {
        const response = await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showToast('¡Mensaje enviado con éxito! Te responderé lo antes posible.', 'success');
          form.reset();
        } else {
          showToast(result.error || 'Error al enviar el mensaje. Inténtalo de nuevo.', 'error');
        }
      } catch (err) {
        showToast('Error de conexión. Verifica tu internet e inténtalo de nuevo.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.innerHTML = originalBtnContent;
      }
    });
  }
</script>

<style>
  .contact {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg) var(--space-xl);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xl);
  }

  .section-head h2 {
    font-size: var(--text-2xl);
  }

  .contact-tile {
    padding: var(--space-xl);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .contact-info h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .contact-info p {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule);
    color: var(--color-ink-2);
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .contact-method:not(.no-link):hover {
    border-color: var(--color-accent);
  }

  .method-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .method-value {
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-group label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink);
    width: 100%;
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-accent);
  }

  .btn-submit {
    margin-top: var(--space-xs);
  }

  .btn-submit-icon {
    transition: transform var(--dur-short) var(--ease-out);
  }

  .btn-submit:hover .btn-submit-icon {
    transform: translateX(3px);
  }

  /* Toasts */
  .toast-container {
    position: fixed;
    bottom: var(--space-lg);
    right: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    z-index: var(--z-toast);
    pointer-events: none;
    max-width: 380px;
    width: calc(100% - 2 * var(--space-lg));
  }

  :global(.toast) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    box-shadow: 0 10px 30px oklch(24% 0.02 258 / 0.12);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    pointer-events: auto;
    animation: toast-fade-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    position: relative;
    overflow: hidden;
  }

  :global(.toast::before) {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--color-accent);
    animation: toast-progress 4.6s linear forwards;
  }

  :global(.toast-success::before) { background: var(--color-success); }
  :global(.toast-error::before) { background: var(--color-error); }
  :global(.toast-success .toast-icon) { color: var(--color-success); }
  :global(.toast-error .toast-icon) { color: var(--color-error); }
  :global(.toast-info .toast-icon) { color: var(--color-accent); }

  :global(.toast-icon) {
    flex-shrink: 0;
  }

  @keyframes toast-fade-in {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes toast-fade-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-0.5rem); }
  }

  @keyframes toast-progress {
    from { width: 100%; }
    to { width: 0%; }
  }

  :global(.spinning) {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Ft2 — inline single line footer */
  .footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-lg);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .footer-sep {
    color: var(--color-rule);
  }

  @media (max-width: 40rem) {
    .contact-tile {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      padding: var(--space-lg);
    }

    .toast-container {
      bottom: var(--space-md);
      right: var(--space-md);
      width: calc(100% - 2 * var(--space-md));
    }
  }
</style>
